  "window": {
    "navigationBarTitleText": "涵词典",
    "navigationBarBackgroundColor": "@pageBackground",
    "navigationBarTextStyle": "@navigationText",
    "backgroundColor": "@pageBackground",
    "backgroundTextStyle": "@backgroundText"
  },
  "tabBar": {
    "custom": true,
    "color": "@tabText",
    "selectedColor": "@tabSelected",
    "backgroundColor": "@tabBackground",
    "borderStyle": "@tabBorder",
    "list": [
      {
        "text": "词典",
        "iconPath": "assets/search.png",
        "selectedIconPath": "assets/search-on.png",
        "pagePath": "pages/search/index"
      },
      {
        "text": "AI",
        "iconPath": "assets/ai.png",
        "selectedIconPath": "assets/ai-on.png",
        "pagePath": "pages/ai/index"
      },
      {
        "text": "生词笔记",
        "iconPath": "assets/bookmark.png",
        "selectedIconPath": "assets/bookmark-on.png",
        "pagePath": "pages/notebook/index"
      },
      {
        "text": "学习",
        "iconPath": "assets/study.png",
        "selectedIconPath": "assets/study-on.png",
        "pagePath": "pages/study/index"
      },
      {
        "text": "我的",
        "iconPath": "assets/profile.png",
        "selectedIconPath": "assets/profile-on.png",
        "pagePath": "pages/profile/index"
      }
    ]
  },
  "style": "v2",
  "usingComponents":{"group-picker":"/components/group-picker/index"},
  "darkmode": true,
  "themeLocation": "theme.json",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json",
  "networkTimeout": {
    "downloadFile": 120000,
    "request": 120000,
    "uploadFile": 120000
  }
}
