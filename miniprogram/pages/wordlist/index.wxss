.wordlist-input{height:600rpx;margin-top:20rpx;line-height:1.85}.list{margin:30rpx 0;max-height:none}
.oxford-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin:24rpx 0}.oxford-actions button{font-size:25rpx}.oxford-word-row{display:flex;align-items:center;border-bottom:1rpx solid var(--line)}.oxford-word-row .word-row{flex:1;min-width:0;border-bottom:0}.oxford-word-row .text-button{flex:none;font-size:23rpx}.oxford-catalog-row .word{font-size:29rpx}.title{overflow-wrap:anywhere}
