.wordlist-input{height:600rpx;margin-top:20rpx;line-height:1.85}.list{margin:30rpx 0;max-height:none}
.oxford-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin:24rpx 0}.oxford-actions button{font-size:25rpx}.oxford-word-item{border-bottom:1rpx solid var(--line)}.oxford-word-row{display:flex;align-items:center}.oxford-word-row .word-row{flex:1;min-width:0;border-bottom:0}.oxford-row-controls{display:flex;align-items:center;gap:14rpx;padding-right:20rpx;flex:none}.oxford-row-controls .text-button{font-size:23rpx}.page .oxford-speak{padding:8rpx 14rpx;border-radius:20rpx;background:var(--soft);border-color:var(--line);color:var(--blue-strong);font-size:23rpx}.page .oxford-speak.active{border-color:var(--blue)}.oxford-voice-info{padding:0 28rpx 18rpx;color:var(--muted);font-size:22rpx;line-height:1.7;overflow-wrap:anywhere}.oxford-catalog-row .word{font-size:29rpx}.title{overflow-wrap:anywhere}
