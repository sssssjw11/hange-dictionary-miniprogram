<view class="page {{theme}}"><text class="eyebrow">WORD LIST</text><view class="title">{{name}}</view><view wx:if="{{creating}}"><view class="info">每行一个英文单词或短语，也可导入 UTF-8 的 TXT / CSV / TSV 文件。CSV 的第一列作为单词。</view><view wx:if="{{fileName}}" class="info">已选择 {{fileName}} · {{fileCharacters}} 字符。保存时解析整个文件。<button class="text-button" bindtap="onManual">改为手动输入</button></view><textarea wx:else class="field wordlist-input" value="{{text}}" maxlength="500000" bindinput="onInput" placeholder="apple&#10;reach out&#10;interpersonal skills"/><view class="actions"><button bindtap="onImport">从文件导入</button><button class="primary" bindtap="onSave">保存词表</button></view></view><view wx:else><button class="text-button" bindtap="onExport">导出词表</button><view class="subtitle">{{total}} 个单词 / 短语，点击可查完整释义。</view><input class="field" value="{{query}}" bindinput="onSearch" placeholder="搜索词表中的单词或短语"/><view class="card list"><view wx:for="{{rows}}" wx:key="*this" class="row"><button class="word-row" data-word="{{item}}" bindtap="onWord">{{item}}</button><button wx:if="{{mastered}}" class="text-button" data-word="{{item}}" bindtap="onRelearn">重新学习</button></view><view wx:if="{{!rows.length}}" class="empty">词表为空，先收藏一些单词。</view></view><view wx:if="{{listPages > 1}}" class="actions pagination"><button disabled="{{listPage === 0}}" bindtap="onPrev">上一页</button><text>{{listPage + 1}} / {{listPages}}</text><button disabled="{{listPage + 1 >= listPages}}" bindtap="onNext">下一页</button></view><button wx:if="{{custom}}" bindtap="onDelete">删除此词表</button></view></view>
