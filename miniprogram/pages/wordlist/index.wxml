<view class="page {{theme}}">
 <view class="title">{{name}}</view>
 <view wx:if="{{oxfordCatalog || oxfordList}}">
  <view wx:if="{{oxfordCatalog}}" class="info">核心词汇、等级词表、牛津主题与 OPAL 学术词表，来自已导入的词库。</view>
  <view wx:elif="{{!loading && !error}}" class="subtitle">全表 {{sourceRecords}} 条词性或语境记录 · {{uniqueWords}} 个词条。加入学习时按词条去重。</view>
  <input class="field" value="{{query}}" bindinput="onSearch" placeholder="{{oxfordCatalog ? '搜索词表名称、主题或等级' : '搜索词条、词性、级别或语境'}}"/>
  <view wx:if="{{loading}}" class="loading">正在读取词库词表…</view>
  <view wx:elif="{{error}}" class="card error-card"><text>{{error}}</text><button bindtap="onRetryOxford">重新读取</button></view>
  <view wx:else>
   <view wx:if="{{oxfordList}}" class="oxford-actions"><button disabled="{{imported || !uniqueWords}}" class="primary" bindtap="onOxfordImport">{{imported ? '已加入学习词表' : '加入整份学习词表'}}</button><button disabled="{{!imported}}" bindtap="onOxfordLearn">开始学习</button><button disabled="{{!imported}}" bindtap="onOxfordPlay">连续播放</button><button bindtap="onExport">导出词表</button></view>
   <view class="subtitle">{{total}} {{oxfordCatalog ? '份词表' : '条记录'}}{{query ? '符合当前搜索' : ''}}</view>
   <view class="card list">
    <block wx:if="{{oxfordCatalog}}"><button wx:for="{{rows}}" wx:key="id" class="word-row oxford-catalog-row" data-id="{{item.id}}" bindtap="onOxfordCatalog"><text class="word">{{item.name}}</text><text class="meaning">{{item.group}}　›</text></button></block>
    <block wx:else><view wx:for="{{rows}}" wx:key="index" class="oxford-word-item"><view class="oxford-word-row"><button class="word-row" data-index="{{item.index}}" bindtap="onOxfordWord"><text class="word">{{item.word}}</text><text class="meaning">{{item.pos}}{{item.level ? ' · '+item.level : ''}}{{item.note ? ' · '+item.note : ''}}</text></button><view class="oxford-row-controls"><button wx:if="{{item.relatedWord}}" class="text-button" data-index="{{item.index}}" bindtap="onOxfordRelated">相关词</button><button class="oxford-speak {{speakingIndex === item.index ? 'active' : ''}}" data-index="{{item.index}}" bindtap="onOxfordSpeak">{{speakingIndex === item.index ? '停止' : '朗读'}}</button></view></view><view wx:if="{{voiceInfoIndex === item.index && voiceInfo}}" class="oxford-voice-info">{{voiceInfo}}</view></view></block>
    <view wx:if="{{!rows.length}}" class="empty">没有符合当前条件的内容。</view>
   </view>
   <view wx:if="{{listPages > 1}}" class="actions pagination"><button disabled="{{listPage === 0}}" bindtap="onPrev">上一页</button><text>{{listPage + 1}} / {{listPages}}</text><button disabled="{{listPage + 1 >= listPages}}" bindtap="onNext">下一页</button></view>
   <view wx:if="{{oxfordList}}" class="footer">词性、等级与语境按原词表显示。朗读遵循发音设置；原版录音需要额外的媒体文件。部分学术短语没有独立释义，可查看相关词。</view>
  </view>
 </view>
 <block wx:else><view wx:if="{{creating}}"><view class="info">每行一个英文单词或短语，也可导入 UTF-8 的 TXT / CSV / TSV 文件。CSV 的第一列作为单词。</view><view wx:if="{{fileName}}" class="info">已选择 {{fileName}} · {{fileCharacters}} 字符。保存时解析整个文件。<button class="text-button" bindtap="onManual">改为手动输入</button></view><textarea wx:else class="field wordlist-input" value="{{text}}" maxlength="500000" bindinput="onInput" placeholder="apple&#10;reach out&#10;interpersonal skills"/><view class="actions"><button bindtap="onImport">从文件导入</button><button class="primary" bindtap="onSave">保存词表</button></view></view><view wx:else><button class="text-button" bindtap="onExport">导出词表</button><view class="subtitle">{{total}} 个单词 / 短语，点击可查完整释义。</view><input class="field" value="{{query}}" bindinput="onSearch" placeholder="搜索词表中的单词或短语"/><view class="card list"><view wx:for="{{rows}}" wx:key="*this" class="row"><button class="word-row" data-word="{{item}}" bindtap="onWord">{{item}}</button><button wx:if="{{mastered}}" class="text-button" data-word="{{item}}" bindtap="onRelearn">重新学习</button></view><view wx:if="{{!rows.length}}" class="empty">词表为空，先收藏一些单词。</view></view><view wx:if="{{listPages > 1}}" class="actions pagination"><button disabled="{{listPage === 0}}" bindtap="onPrev">上一页</button><text>{{listPage + 1}} / {{listPages}}</text><button disabled="{{listPage + 1 >= listPages}}" bindtap="onNext">下一页</button></view><button wx:if="{{custom}}" bindtap="onDelete">删除此词表</button></view></block>
</view>
