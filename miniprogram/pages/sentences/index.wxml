<view class="page {{theme}}"><view class="row"><view class="title">例句卡片</view><button class="text-button" bindtap="onNew">新建卡片</button></view><input class="field" value="{{query}}" bindinput="onSearch" placeholder="搜索例句、译文或笔记"/><view wx:if="{{editing}}" class="card editor"><textarea class="field" value="{{en}}" bindinput="onEn" maxlength="6000" placeholder="英文或原文"/><textarea class="field" value="{{zh}}" bindinput="onZh" maxlength="6000" placeholder="中文译文（可选）"/><textarea class="field" value="{{note}}" bindinput="onNote" maxlength="2000" placeholder="自己的笔记（可选）"/><view class="actions"><button class="primary" bindtap="onSave">保存</button><button bindtap="onCancel">取消</button></view></view><view wx:for="{{rows}}" wx:key="id" class="card sentence-card"><text class="sentence-en" selectable="true">{{item.en}}</text><text wx:if="{{item.zh}}" class="sentence-zh" selectable="true">{{item.zh}}</text><view wx:if="{{item.note}}" class="info">{{item.note}}</view><text class="small muted">{{item.source}}</text><view class="actions"><button data-id="{{item.id}}" bindtap="onSpeak">朗读</button><button data-id="{{item.id}}" bindtap="onCopy">复制</button><button data-id="{{item.id}}" bindtap="onEdit">编辑</button><button data-id="{{item.id}}" bindtap="onDelete">删除</button></view></view><view wx:if="{{listPages > 1}}" class="actions pagination"><button disabled="{{listPage === 0}}" bindtap="onPrev">上一页</button><text>{{listPage + 1}} / {{listPages}}</text><button disabled="{{listPage + 1 >= listPages}}" bindtap="onNext">下一页</button></view><view wx:if="{{!rows.length}}" class="empty">在词条、阅读材料中收藏例句，也可以自己新建。</view></view>
