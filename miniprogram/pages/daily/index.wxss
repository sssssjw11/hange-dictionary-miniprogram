.daily-heading{padding:10rpx 0 8rpx}.daily-heading .eyebrow{font-size:24rpx}.daily-card{padding:32rpx;margin:32rpx 0 24rpx}.daily-meta{display:flex;align-items:center;justify-content:space-between;gap:16rpx;color:var(--blue-strong);font-size:28rpx;margin-bottom:28rpx}.daily-meta text:last-child{color:var(--muted);overflow-wrap:anywhere;text-align:right}.daily-en{display:block;font-size:39rpx;font-weight:500;line-height:1.65;overflow-wrap:anywhere}.daily-zh{display:block;font-size:28rpx;color:var(--muted);line-height:1.85;margin-top:24rpx;overflow-wrap:anywhere}.daily-listening,.daily-loading{padding:46rpx 4rpx;color:var(--muted);font-size:27rpx;line-height:1.8}.daily-controls{display:flex;align-items:center;gap:22rpx;flex-wrap:wrap;margin-top:32rpx}.page .daily-controls .play{padding:14rpx 24rpx;font-size:28rpx}.page .daily-controls .reveal{padding:10rpx 0}.daily-voice{color:var(--muted);font-size:26rpx;line-height:1.7;margin-top:18rpx;overflow-wrap:anywhere}.daily-actions{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12rpx}.page .daily-actions button{width:100%;padding:15rpx 4rpx;font-size:28rpx;white-space:normal}.daily-page .footer{font-size:26rpx}.dark .daily-card{border-color:var(--line)}
@media(max-width:350px){.daily-actions{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(min-width:700px){.daily-en{font-size:25px}.daily-zh{font-size:17px}.daily-meta,.daily-voice{font-size:13px}.page .daily-actions button,.page .daily-controls .play{font-size:14px}}
