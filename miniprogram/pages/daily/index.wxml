<view class="page daily-page {{theme}}">
 <view class="daily-heading"><text class="eyebrow">{{item.date}} · DAILY PRACTICE</text><view class="title">{{listening ? '听一句，理解一句。' : '每日一句'}}</view><view class="subtitle">{{loading ? '正在寻找今天的例句…' : discoveryStatus}}</view></view>
 <view class="card daily-card">
  <view class="daily-meta"><text>{{item.source}}</text><text>{{item.word}}</text></view>
  <view wx:if="{{loading}}" class="daily-loading">正在翻阅词库，请稍候…</view>
  <block wx:else><text wx:if="{{revealed}}" class="daily-en" selectable="true">{{item.en}}</text><view wx:else class="daily-listening">先听发音，再尝试复述句子。</view><text wx:if="{{revealed}}" class="daily-zh" selectable="true">{{item.zh}}</text></block>
  <view class="daily-controls"><button class="primary play" disabled="{{loading}}" bindtap="onPlay">{{busy ? '停止朗读' : '播放英语朗读'}}</button><button wx:if="{{listening}}" class="text-button reveal" disabled="{{loading}}" bindtap="onReveal">{{revealed ? '隐藏文字再听' : '显示原文与译文'}}</button></view>
  <view wx:if="{{voiceStatus}}" class="daily-voice">{{voiceStatus}}</view>
 </view>
 <view class="daily-actions"><button disabled="{{loading}}" bindtap="onChange">换一句</button><button disabled="{{loading}}" bindtap="onSave">收藏例句</button><button disabled="{{loading}}" bindtap="onLookup">查相关词</button><button disabled="{{loading || !revealed}}" bindtap="onCopy">复制</button></view>
 <view wx:if="{{revealed && item.note && !loading}}" class="info">{{item.note}}</view>
 <view class="footer">优先从已配置的牛津词库读取双语例句；没有可用词库时使用原创学习例句。朗读来源遵循发音设置。</view>
</view>
