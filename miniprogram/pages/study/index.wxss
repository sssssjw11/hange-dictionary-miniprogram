.study-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin:7rpx 0 26rpx}.streak{display:flex;align-items:center;gap:8rpx;font-size:22rpx;color:var(--blue-strong);background:var(--soft);border-radius:26rpx;padding:9rpx 15rpx}.streak-dot{width:6rpx;height:6rpx;background:var(--blue);border-radius:50%}
.study-summary{padding:25rpx 26rpx 28rpx;border-color:#dcecf8;background:linear-gradient(130deg,#f1f8ff,#fff 80%)}.summary-label{display:flex;justify-content:space-between;gap:14rpx;font-size:23rpx;color:#7597b3}.summary-label>text:last-child{color:#a0b4c5;font-size:20rpx}.study-metrics{display:flex;margin-top:24rpx;justify-content:space-between;gap:15rpx}.study-metrics>view{display:flex;flex-direction:column;gap:5rpx;min-width:0}.study-metrics .metric{font-size:52rpx;font-weight:600;line-height:1.25;color:#273f54;font-family:-apple-system,BlinkMacSystemFont,sans-serif}.metric-total{font-size:23rpx;color:#9fb1c0}.metric-label{font-size:22rpx;color:#92a2b1}
.continue-card{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:21rpx 22rpx;border:1rpx solid var(--line);background:var(--paper);border-radius:18rpx;margin-top:18rpx;font-size:26rpx}.continue-card>view{display:flex;flex-direction:column;gap:5rpx}.continue-card button{background:none;border:0;color:var(--blue-strong);padding:5rpx;font-size:25rpx;flex:none}.continue-card button text{margin-left:8rpx}
.practice-heading{display:flex;justify-content:space-between;gap:20rpx;margin:32rpx 0 18rpx;font-size:25rpx;color:var(--ink)}.practice-heading>text:last-child{font-size:22rpx;color:var(--muted);min-width:0;max-width:55%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.practice-modes{display:flex;gap:14rpx}.page button.mode-button{display:flex;flex:1;min-width:0;flex-direction:column;align-items:center;gap:7rpx;padding:18rpx 5rpx;border-radius:18rpx;border-color:var(--line);background:var(--paper);font-size:24rpx;color:var(--muted)}.mode-symbol{font-family:Georgia,serif;font-size:32rpx;line-height:1.3;color:#7d91a3}.page button.mode-button.selected{border-color:#acd1ef;background:var(--soft);color:var(--blue-strong)}.selected .mode-symbol{color:var(--blue-strong)}.page button.start-study{display:flex;align-items:center;justify-content:center;gap:18rpx;width:100%;min-height:95rpx;margin:24rpx 0 13rpx;border-radius:19rpx;font-size:30rpx}.start-study text{font-size:22rpx;font-weight:400;opacity:.8}.play-entry{display:flex;align-items:center;justify-content:center;gap:11rpx;border:0;background:transparent;color:var(--blue-strong);padding:12rpx;font-size:24rpx}.play-entry image{width:27rpx;height:27rpx}.play-entry>text:last-child{font-size:28rpx;margin-left:7rpx}
.deck-row{display:flex;align-items:center;padding-right:22rpx}.deck-row+.deck-row{border-top:1rpx solid var(--line)}.deck-select{display:flex;align-items:center;gap:18rpx;flex:1;min-width:0;border:0;background:none;text-align:left;padding:25rpx 23rpx;border-radius:0}.deck-radio{display:flex;align-items:center;justify-content:center;width:32rpx;height:32rpx;border:2rpx solid #cedae4;border-radius:50%;color:#fff;font-size:22rpx;line-height:1;flex:none}.selected .deck-radio{background:#278de0;border-color:#278de0}.deck-copy{flex:1;min-width:0;overflow-wrap:anywhere}.deck-copy text{display:block;font-size:28rpx}.deck-copy>text:last-child{font-size:22rpx;color:var(--muted);margin-top:4rpx}.deck-row>.text-button{font-size:22rpx;flex:none}.deck-row>.text-button text{margin-left:8rpx}
.plan-card{padding:3rpx 25rpx}.plan-card .row{padding:23rpx 0;font-size:26rpx}.plan-card .row+.row{border-top:1rpx solid var(--line)}.plan-card .row>view{display:flex;align-items:center;gap:12rpx;color:var(--muted);font-size:23rpx}.plan-card input{width:80rpx;text-align:right;color:var(--blue-strong);font-size:30rpx}.week-chart{display:flex;justify-content:space-around;align-items:flex-end;min-height:200rpx;padding:26rpx 10rpx}.day-bar{display:flex;flex-direction:column;align-items:center;font-size:20rpx;color:var(--muted);gap:9rpx}.day-bar>view{width:28rpx;max-height:180rpx;background:var(--line);border-radius:5rpx 5rpx 0 0}.day-bar.has-count>view{background:#68a9dc}
.dark .study-summary{background:linear-gradient(130deg,#1e354c,#1b2635);border-color:#2d465d}.dark .study-metrics .metric{color:#d9e9f7}.dark .metric-total,.dark .metric-label{color:#8ca2b6}.page.dark button.mode-button.selected{border-color:#4f7798}
@media(min-width:700px){.streak{font-size:13px}.summary-label{font-size:14px}.summary-label>text:last-child{font-size:12px}.metric-total,.metric-label{font-size:14px}.practice-heading{font-size:16px}.practice-heading>text:last-child{font-size:13px}.page button.mode-button{font-size:15px}.mode-symbol{font-size:22px}.page button.start-study{min-height:50px;font-size:17px}.start-study text,.play-entry{font-size:14px}.deck-copy text{font-size:16px}.deck-copy>text:last-child,.deck-row>.text-button{font-size:13px}.plan-card .row{font-size:16px}.plan-card input{font-size:18px}}
