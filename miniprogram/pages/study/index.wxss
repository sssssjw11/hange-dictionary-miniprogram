.study-metrics{display:flex;padding:26rpx 10rpx;justify-content:space-around;margin-top:30rpx}.study-metrics>view{display:flex;flex-direction:column;text-align:center;color:var(--muted);font-size:23rpx}.metric{font-size:45rpx;font-weight:700;color:var(--ink)}.deck-row{display:flex;align-items:center;padding-right:24rpx}.deck-row+.deck-row{border-top:1rpx solid var(--line)}.deck-select{flex:1;border:0;background:none;text-align:left;padding:24rpx;border-radius:0}.deck-select.selected{border-left:5rpx solid var(--blue);background:var(--soft)}.deck-select .word{font-size:29rpx}.selected.chip{background:var(--soft);border-color:var(--blue)}.start-study{margin:28rpx 0}.plan-card{padding:12rpx 26rpx}.plan-card .row{padding:18rpx 0}.plan-card input{width:100rpx;text-align:right;color:var(--blue)}.week-chart{display:flex;justify-content:space-around;align-items:flex-end;min-height:190rpx;padding:24rpx 10rpx}.day-bar{display:flex;flex-direction:column;align-items:center;font-size:21rpx;color:var(--muted);gap:7rpx}.day-bar>view{width:32rpx;max-height:180rpx;background:var(--blue);border-radius:5rpx 5rpx 0 0}
