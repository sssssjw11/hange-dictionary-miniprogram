<view class="page tab-page study-page {{theme}}">
  <view class="study-heading"><view class="title">今日学习</view><view class="streak"><text class="streak-dot"></text>连续 {{stats.streak}} 天</view></view>
  <view class="study-summary card"><view class="summary-label"><text>每天一点，慢慢记牢</text><text>今日计划</text></view><view class="study-metrics"><view><view><text class="metric">{{stats.today.new || 0}}</text><text class="metric-total"> / {{dailyNew}}</text></view><text class="metric-label">新学单词</text></view><view><view><text class="metric">{{stats.today.review || 0}}</text><text class="metric-total"> / {{dailyReview}}</text></view><text class="metric-label">复习单词</text></view><view><text class="metric">{{stats.mastered}}</text><text class="metric-label">已掌握</text></view></view></view>
  <button class="play-entry" bindtap="onStatistics"><text>学习记录与每日明细</text><text>›</text></button>
  <view wx:if="{{stats.pending}}" class="continue-card"><view><text>上次还差一点</text><text class="small muted">接着未完成的进度，继续学习。</text></view><button bindtap="onContinue">继续 <text>›</text></button></view>
  <view class="practice-heading"><text>练习方式</text><text>{{deckName}}</text></view>
  <view class="practice-modes"><button class="mode-button {{mode === 'flash' ? 'selected' : ''}}" data-mode="flash" bindtap="onMode"><text class="mode-symbol">Aa</text><text>词卡回忆</text></button><button class="mode-button {{mode === 'spell' ? 'selected' : ''}}" data-mode="spell" bindtap="onMode"><text class="mode-symbol">a_</text><text>单词拼写</text></button><button class="mode-button {{mode === 'choice' ? 'selected' : ''}}" data-mode="choice" bindtap="onMode"><text class="mode-symbol">✓</text><text>选义练习</text></button></view>
  <button class="primary start-study" disabled="{{!queued}}" bindtap="onStart">{{queued ? '开始学习' : deckCount ? '今日计划已完成' : '先选择一个有单词的词表'}}<text wx:if="{{queued}}">{{queued}} 词待学</text></button><button class="play-entry" bindtap="onPlayer"><image src="/assets/headphones-on.png"/><text>单词连续播放</text><text>›</text></button>
  <view class="section-head"><text class="section-title">我的词表</text><button class="text-button" bindtap="onCreate">＋ 导入词表</button></view>
  <button class="play-entry" bindtap="onVocabulary"><text>从文章提取单词</text><text>粘贴 · 勾选 · 学习　›</text></button>
  <button class="play-entry" bindtap="onOxfordWordlists"><text>牛津词库词表</text><text>等级 · 主题 · OPAL　›</text></button>
  <view class="card decks"><view wx:for="{{decks}}" wx:key="id" class="deck-row"><button class="deck-select {{deck === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="onDeck"><view class="deck-radio">{{deck === item.id ? '✓' : ''}}</view><view class="deck-copy"><text>{{item.name}}</text><text>{{item.count}} 个单词 / 短语</text></view></button><button class="text-button" data-id="{{item.id}}" bindtap="onWordlist">查看 <text>›</text></button></view></view>
  <view class="section-head"><text class="section-title">学习计划</text><button class="text-button" bindtap="onSavePlan">保存</button></view><view class="card plan-card"><view class="row"><text>每日新词</text><view><input type="number" value="{{dailyNew}}" bindinput="onNew" maxlength="3"/><text>词</text></view></view><view class="row"><text>每日复习</text><view><input type="number" value="{{dailyReview}}" bindinput="onReview" maxlength="3"/><text>词</text></view></view></view>
  <view class="section-head"><text class="section-title">最近七天</text><button class="text-button" bindtap="onMastered">熟词管理 <text>›</text></button></view><view class="card week-chart"><view wx:for="{{stats.days}}" wx:key="date" class="day-bar {{item.count ? 'has-count' : ''}}"><text>{{item.count}}</text><view style="height:{{item.count > 100 ? 100 : item.count + 3}}px"></view><text>{{item.date}}</text></view></view>
  <view class="footer">忘记的词再见几次，记住的词间隔久一点。</view>
</view>
