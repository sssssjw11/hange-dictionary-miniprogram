<view class="page tab-page search-page {{theme}}">
  <view class="search-row">
    <button class="icon-button menu-button" bindtap="onMenu" aria-label="打开功能菜单"><image src="/assets/menu-on.png"/></button>
    <view class="search-box">
      <input class="search-input" value="{{query}}" placeholder="查询单词或短语" placeholder-class="search-placeholder" confirm-type="search" maxlength="256" bindinput="onInput" bindconfirm="onSearch"/>
      <button wx:if="{{query}}" class="clear-button" bindtap="onClear" aria-label="清空搜索">×</button>
      <button wx:else class="icon-button voice-button" bindtap="onVoice" aria-label="语音查词"><image src="/assets/mic-on.png"/></button>
    </view>
    <button class="icon-button camera-button" bindtap="onCapture" aria-label="拍照识词"><image src="/assets/camera-on.png"/></button>
  </view>
  <view wx:if="{{!hasOffline}}" class="dictionary-status"><view class="status-copy"><view class="status-dot {{hasOffline ? 'ready' : ''}}"></view><text>{{hasOffline ? '牛津高阶 · 第10版 · 离线可查' : '常用示例 · 支持中文释义反查'}}</text></view><button class="text-button" bindtap="onDictionaries">{{hasOffline ? '词库' : '导入牛津'}}<text class="tiny-chevron">›</text></button></view>
  <view wx:if="{{query}}" class="suggestions">
    <button class="query-action search-button" bindtap="onSearch"><image src="/assets/search-on.png"/><text>查询“{{query}}”</text><text class="suggest-chevron">›</text></button>
    <button wx:for="{{suggestions}}" wx:key="word" class="suggestion-row" data-word="{{item.word}}" bindtap="onWord"><view class="history-copy"><text class="history-word">{{item.word}}</text><text class="history-meaning">{{item.meaning}}</text></view><image class="suggest-arrow" src="/assets/chevron.png"/></button>
  </view>
  <view wx:else>
    <view class="discovery-tabs"><button class="topic-tab {{discovery === 'sentence' ? 'active' : ''}}" data-tab="sentence" bindtap="onDiscovery">每日一句<view wx:if="{{discovery === 'sentence'}}" class="tab-underline"></view></button><button class="topic-tab {{discovery === 'listening' ? 'active' : ''}}" data-tab="listening" bindtap="onDiscovery">每日听力<view wx:if="{{discovery === 'listening'}}" class="tab-underline"></view></button><button class="topic-tab {{discovery === 'knowledge' ? 'active' : ''}}" data-tab="knowledge" bindtap="onDiscovery">用法知识<view wx:if="{{discovery === 'knowledge'}}" class="tab-underline"></view></button></view>
    <view class="history-list"><button wx:for="{{recent}}" wx:key="word" class="history-item" data-word="{{item.word}}" bindtap="onWord"><image class="history-clock" src="/assets/history.png"/><view class="history-copy"><text class="history-word">{{item.word}}</text><text wx:if="{{item.meaning}}" class="history-meaning">{{item.meaning}}</text></view><text wx:if="{{item.hits > 1}}" class="history-hits">已查 {{item.hits}} 次</text></button></view>
    <button wx:if="{{recent.length}}" class="more-history" bindtap="onHistory">查看全部查词记录 <text>›</text></button>
    <view wx:if="{{!recent.length}}" class="search-empty"><image src="/assets/search.png"/><text class="empty-title">从一个词开始</text><text class="empty-description">查过的词会留在这里，方便下次再见。</text><view class="starter-words"><button wx:for="{{shortcuts}}" wx:key="*this" data-word="{{item}}" bindtap="onWord">{{item}} <text>↗</text></button></view></view>
  </view>
</view>
