.brand-row{display:flex;align-items:center;justify-content:space-between;margin:0 0 34rpx}.brand{display:flex;align-items:center;font-weight:700;font-size:36rpx;gap:14rpx}.brand-mark{color:var(--blue);border:2rpx solid var(--blue);border-radius:6rpx;line-height:40rpx;width:42rpx;text-align:center;font-size:25rpx}.edition{font-size:16rpx;color:var(--blue);background:var(--soft);padding:2rpx 10rpx;border-radius:4rpx;letter-spacing:2rpx;margin-left:2rpx}.search-wrap{display:flex;align-items:center;border:2rpx solid #bbd5e8;border-radius:24rpx;padding:10rpx;background:var(--paper)}.search-wrap .search-icon{margin-left:12rpx;margin-right:14rpx}.search-input{flex:1;min-width:0;font-size:29rpx;height:76rpx}.search-button{font-size:27rpx;padding:15rpx 25rpx;border-radius:18rpx;white-space:nowrap}.clear{border:0;padding:2rpx 14rpx;font-size:36rpx;color:var(--muted);background:none}.connection{display:flex;align-items:center;gap:10rpx;color:var(--muted);font-size:20rpx;margin:16rpx 0}.status-dot{width:9rpx;height:9rpx;background:#5aa58c;border-radius:50%}.local-label{margin-left:auto;color:#5a9a83}.hero{padding:48rpx 4rpx 18rpx}.hero .title{font-size:49rpx}.hero-chips{margin-top:30rpx}.capabilities{display:flex;justify-content:space-between;border-top:1rpx solid var(--line);margin-top:38rpx;padding:28rpx 16rpx;gap:14rpx}.capabilities>view{display:flex;flex-direction:column;gap:6rpx}.metric{font-weight:700;font-size:32rpx;color:var(--ink)}.suggest-list{margin-top:20rpx;max-height:600rpx;overflow-y:auto}
.quick-tools{display:flex;gap:12rpx;margin:28rpx 0}.quick-tools button{flex:1;padding:20rpx 5rpx;min-width:0;font-size:26rpx}.quick-tools button text{display:block}.quick-tools .small{font-size:19rpx;margin-top:6rpx}.daily-tabs{display:flex;justify-content:space-between;border-bottom:1rpx solid var(--line);padding:6rpx 0 22rpx}.daily-tabs button{border:0;background:none;color:var(--blue);font-size:26rpx;padding:6rpx 12rpx}.hero{padding-top:34rpx}
