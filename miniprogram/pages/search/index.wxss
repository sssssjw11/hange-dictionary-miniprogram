.page.search-page{padding:16rpx 22rpx 180rpx;padding-bottom:calc(180rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,#edf6ff 0,#f6fbff 220rpx,#fff 460rpx);--bg:#fff}.page.search-page.dark{background:linear-gradient(180deg,#17293b 0,#152333 220rpx,#131b26 460rpx);--bg:#131b26}
.search-row{display:flex;align-items:center;gap:4rpx}.page button.icon-button{width:32px;min-width:32px;height:48px;display:flex;align-items:center;justify-content:center;padding:0;border:0;background:transparent;border-radius:12rpx}.icon-button image{width:24px;height:24px}.menu-button image{width:20px;height:20px}.page button.voice-button{width:36px;min-width:36px;height:46px}.voice-button image{width:22px;height:26px}
.search-box{display:flex;align-items:center;flex:1;min-width:0;height:96rpx;min-height:48px;max-height:56px;padding:2rpx 6rpx 2rpx 20rpx;background:var(--paper);border:2rpx solid #3595dd;border-radius:20rpx;box-shadow:0 5rpx 22rpx rgba(61,127,183,.035)}.search-input{flex:1;min-width:0;height:80rpx;font-size:29rpx;color:var(--ink)}.search-placeholder{color:#9eb8ce}.clear-button{flex:none;border:0;padding:0 14rpx;background:transparent;color:var(--muted);font-size:38rpx}
.dictionary-status{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:18rpx 10rpx 12rpx 12rpx;color:#8ba0b1;font-size:21rpx}.status-copy{display:flex;align-items:center;gap:10rpx;min-width:0}.status-copy text{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.status-dot{width:7rpx;height:7rpx;background:#b5c6d5;border-radius:50%;flex:none}.status-dot.ready{background:#6aaf9a}.dictionary-status .text-button{font-size:21rpx;flex:none}.tiny-chevron{font-size:28rpx;padding-left:9rpx}
.discovery-tabs{display:flex;align-items:center;margin:12rpx 0 0}.page button.topic-tab{position:relative;flex:1;min-width:0;width:0;height:82rpx;padding:10rpx 0 23rpx;border:0;border-radius:0;background:transparent;color:#a3aab3;font-size:30rpx;font-weight:400;line-height:1.5}.page button.topic-tab.active{color:var(--ink);font-weight:500}.tab-underline{position:absolute;bottom:6rpx;left:50%;transform:translateX(-50%);width:42rpx;height:6rpx;border-radius:8rpx;background:var(--blue)}
.history-item{display:flex;align-items:center;gap:20rpx;width:100%;padding:18rpx 10rpx;border:0;border-radius:0;background:transparent;text-align:left}.page button.history-item{width:100%}.history-clock{width:28rpx;height:28rpx;flex:none;opacity:.75;align-self:flex-start;margin-top:10rpx}.history-copy{flex:1;min-width:0}.history-word{display:block;font-size:34rpx;font-weight:400;line-height:1.4;color:var(--ink);overflow-wrap:anywhere;word-break:break-word}.history-meaning{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:25rpx;line-height:1.5;color:#9aa1ab;margin-top:5rpx}.history-hits{font-size:20rpx;color:#b3bac3;align-self:flex-end;padding-bottom:5rpx;flex:none}
.search-empty{display:flex;flex-direction:column;align-items:center;padding:66rpx 22rpx 24rpx}.search-empty>image{height:62rpx;width:62rpx;opacity:.5;margin-bottom:22rpx}.empty-title{font-size:29rpx;color:#728496}.empty-description{font-size:23rpx;color:#a7b1bd;margin-top:10rpx}.starter-words{display:flex;justify-content:center;flex-wrap:wrap;gap:12rpx;margin-top:28rpx}.starter-words button{padding:9rpx 18rpx;border:0;background:#f2f7fb;border-radius:28rpx;font-size:22rpx;color:#7d9ab2}.starter-words button text{margin-left:8rpx;color:#a1b7c9}
.suggestions{margin:16rpx 12rpx}.page button.query-action{display:flex;align-items:center;gap:16rpx;width:100%;padding:22rpx 6rpx;border:0;border-radius:0;border-bottom:1rpx solid var(--line);background:transparent;color:var(--blue-strong);text-align:left;font-size:28rpx}.query-action image{width:30rpx;height:30rpx}.query-action>text:nth-child(2){flex:1;min-width:0;overflow-wrap:anywhere}.suggest-chevron{color:var(--muted);font-size:34rpx}.page button.suggestion-row{display:flex;align-items:center;width:100%;padding:24rpx 8rpx;border:0;border-bottom:1rpx solid var(--line);border-radius:0;background:transparent;text-align:left}.suggest-arrow{width:23rpx;height:23rpx;margin-left:18rpx;opacity:.6}
.dark .search-box{border-color:#6aa9db}.dark .history-meaning{color:#99a6b7}.dark .starter-words button{background:#1f3042;color:#9ab6cc}
@media(min-width:700px){.page.search-page{padding:18px 24px 110px;padding-bottom:calc(110px + env(safe-area-inset-bottom));background:linear-gradient(180deg,#edf6ff 0,#fff 280px)}.search-box{height:54px}.dictionary-status{font-size:12px;padding:13px 8px}.dictionary-status .text-button{font-size:12px}.page button.topic-tab{height:52px;font-size:17px}.history-item{padding:18px 12px;gap:15px}.history-word{font-size:22px}.history-meaning{font-size:15px}.history-clock{width:19px;height:19px}.history-hits{font-size:12px}.page.search-page.dark{background:linear-gradient(180deg,#17293b 0,#131b26 280px)}}

.history-list{padding-top:12rpx}.more-history{margin:20rpx auto 10rpx;padding:12rpx 20rpx;border:0;background:transparent;color:#a0adba;font-size:22rpx}.more-history text{margin-left:10rpx}.dark .more-history{color:#7d93aa}
