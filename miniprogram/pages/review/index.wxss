.review-card{padding:42rpx 30rpx;margin:34rpx 0}.review-word{font-size:60rpx;font-weight:700;word-break:break-word;line-height:1.4}.question-meaning{font-size:32rpx;white-space:pre-line;margin:30rpx 0;line-height:1.9}.answer{margin:30rpx 0}.reveal{margin:44rpx 0 14rpx}.grade-buttons{display:flex;gap:10rpx;margin:30rpx 0}.grade-buttons button{flex:1;padding:18rpx 5rpx;font-size:26rpx}.grade-buttons text{display:block;font-size:17rpx;color:var(--muted)}.example{margin-top:24rpx}.detail{margin-top:24rpx}.choices button{margin-top:20rpx;width:100%;text-align:left;white-space:pre-line;font-size:28rpx}.choices .right{border-color:#4c9b7f;background:#4c9b7f22}.choices .wrong{border-color:#bf6c61;background:#bf6c6122}.complete{padding:46rpx 30rpx;text-align:center;margin-top:80rpx}.complete button{margin-top:40rpx}.metric{font-size:50rpx;color:var(--blue);font-weight:700}
