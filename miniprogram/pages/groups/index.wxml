<view class="page {{theme}}"><text class="eyebrow">YOUR COLLECTIONS</text><view class="title">生词本管理</view><view class="subtitle">{{total}} 个生词 · {{rows.length}} / 30 个独立生词本</view><button class="primary group-create" bindtap="onCreate">新建生词本</button><view wx:for="{{rows}}" wx:key="id" class="card book-card"><text class="word">{{item.name}}</text><text class="muted small">{{item.count}} 个单词 / 短语</text><view class="actions"><button data-id="{{item.id}}" bindtap="onOpen">查看单词</button><button data-id="{{item.id}}" bindtap="onRename">重命名</button><button data-id="{{item.id}}" bindtap="onDelete">删除分组</button></view></view><view wx:if="{{!rows.length}}" class="empty">可按考试、课程或阅读材料新建生词本。</view><view class="footer">同一个词可加入多个生词本。删除分组不会删除词条或个人笔记；分类结构请用“完整备份”保存。</view></view>
