.vocabulary-heading{margin:12rpx 0 28rpx}.vocabulary-heading .subtitle{font-size:26rpx;line-height:1.8}.vocabulary-editor{padding:24rpx}.vocabulary-editor textarea{height:320rpx;font-size:28rpx;line-height:1.8;margin-bottom:22rpx}.vocabulary-summary{padding:25rpx;background:linear-gradient(130deg,var(--soft),var(--paper) 85%);margin-bottom:24rpx}.vocabulary-summary .row>text{flex:1;min-width:0;font-size:29rpx;font-weight:600;overflow-wrap:anywhere}.vocabulary-summary .text-button{flex-shrink:0;font-size:24rpx}.vocabulary-count{display:flex;align-items:baseline;flex-wrap:wrap;gap:8rpx;margin:18rpx 0 8rpx;color:var(--muted);font-size:25rpx}.vocabulary-count>text:first-child{font-size:52rpx;color:var(--blue-strong);font-weight:600}.vocabulary-count>text:last-child{margin-left:12rpx}.vocabulary-query{margin:20rpx 0}.vocabulary-filters{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:20rpx 0}.vocabulary-filters>view{display:flex;gap:10rpx}.page .vocabulary-filters button{font-size:25rpx;padding:10rpx 20rpx;border-radius:14rpx;color:var(--muted)}.page .vocabulary-filters button.active{background:var(--soft);border-color:var(--blue);color:var(--blue-strong)}.vocabulary-filters picker{font-size:24rpx;color:var(--muted);flex-shrink:0}.vocabulary-selection{display:flex;align-items:center;justify-content:space-between;gap:10rpx;margin-bottom:18rpx}.vocabulary-selection>view{display:flex;align-items:center;gap:8rpx;font-size:25rpx;color:var(--muted)}.vocabulary-selection switch{transform:scale(.72);transform-origin:left center;margin-right:-24rpx}.vocabulary-selection .text-button{font-size:24rpx;padding:8rpx}.vocabulary-row{padding:24rpx}.vocabulary-row+.vocabulary-row{border-top:1rpx solid var(--line)}.vocabulary-word-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.vocabulary-word-row label{display:flex;align-items:center;gap:12rpx;flex:1;min-width:0}.vocabulary-word-row label>view{min-width:0;flex:1}.vocabulary-word-row checkbox{flex-shrink:0;transform:scale(.8);transform-origin:left center;margin-right:-8rpx}.vocabulary-word{display:block;font-size:33rpx;font-weight:600;overflow-wrap:anywhere}.vocabulary-meta{display:block;font-size:23rpx;color:var(--muted);margin-top:6rpx}.vocabulary-word-row .text-button{font-size:24rpx;flex-shrink:0;padding:8rpx}.vocabulary-context{display:block;font-size:25rpx;line-height:1.8;color:var(--muted);margin-top:16rpx;overflow-wrap:anywhere}.vocabulary-context>text{color:var(--blue-strong)}.vocabulary-meaning,.vocabulary-match-error{display:block;font-size:26rpx;line-height:1.8;margin-top:12rpx;overflow-wrap:anywhere}.vocabulary-match-error{color:#bd635a}.page .vocabulary-original{font-size:24rpx;margin-top:10rpx;padding:5rpx 0}.vocabulary-actions{padding:24rpx;margin-top:26rpx}.vocabulary-actions>.row{font-size:28rpx}.vocabulary-actions .text-button{font-size:24rpx}.vocabulary-actions .actions{gap:12rpx;flex-wrap:wrap}.vocabulary-actions .actions button{min-width:0;flex:1;font-size:26rpx;padding:15rpx 8rpx}.vocabulary-progress{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:16rpx;font-size:26rpx;color:var(--blue-strong)}.vocabulary-message,.vocabulary-hint{display:block;font-size:24rpx;color:var(--muted);line-height:1.8;margin-top:14rpx;overflow-wrap:anywhere}.vocabulary-deck{margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid var(--line)}.vocabulary-deck>text{font-size:25rpx;color:var(--muted)}.vocabulary-deck input{font-size:28rpx;margin-top:12rpx;padding:12rpx 0;min-width:0;color:var(--ink)}.page .vocabulary-create{width:100%;font-size:28rpx;color:var(--blue-strong);background:var(--soft);padding:15rpx;margin-top:18rpx}
.vocabulary-list-heading{display:flex;justify-content:space-between;align-items:center;gap:12rpx;margin:18rpx 0;font-size:25rpx;color:var(--muted)}.vocabulary-list-heading .text-button{padding:8rpx 0;font-size:24rpx}
