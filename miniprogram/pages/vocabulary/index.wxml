<view class="page vocabulary-page {{theme}}">
 <view class="vocabulary-heading"><view class="eyebrow">从读过的内容，积累自己的词</view><view class="title">提取单词</view><view class="subtitle">本机提取，保留原词形。勾选后可生成词表，匹配释义后可加入生词本。</view></view>
 <view wx:if="{{error}}" class="info">{{error}}</view>
 <view wx:if="{{editing}}" class="card vocabulary-editor"><textarea class="field" value="{{draft}}" maxlength="200000" bindinput="onInput" placeholder="粘贴英文文章或识别结果，最多 20 万字符"/><button class="primary" bindtap="onExtract">提取候选词</button></view>
 <block wx:elif="{{hasSource}}">
  <view class="card vocabulary-summary"><view class="row"><text>{{sourceTitle}}</text><button wx:if="{{!article}}" class="text-button" disabled="{{busy}}" bindtap="onEdit">更换文字</button></view><view class="vocabulary-count"><text>{{uniqueTotal}}</text> 个不同词形<text>{{occurrences}} 次出现</text></view><view wx:if="{{skipped}}" class="small muted">已忽略 {{skipped}} 段超过 128 字符的连续字母。</view></view>
  <input class="field vocabulary-query" value="{{query}}" disabled="{{busy}}" bindinput="onQuery" placeholder="筛选候选词"/>
  <view class="vocabulary-filters"><view><button class="{{filter === 'new' ? 'active' : ''}}" data-filter="new" disabled="{{busy}}" bindtap="onFilter">未收藏</button><button class="{{filter === 'all' ? 'active' : ''}}" data-filter="all" disabled="{{busy}}" bindtap="onFilter">全部</button></view><picker range="{{sortNames}}" value="{{sortIndex}}" disabled="{{busy}}" bindchange="onSort"><text>{{sortNames[sortIndex]}}　⌄</text></picker></view>
  <view class="vocabulary-selection"><view><text>隐藏熟词</text><switch checked="{{hideMastered}}" disabled="{{busy}}" color="#278de0" bindchange="onMastered"/></view><button class="text-button" disabled="{{busy || !rows.length}}" bindtap="onSelectPage">选中 / 取消本页</button></view>
  <view class="vocabulary-list-heading"><text>候选词 {{total}}</text><button class="text-button" disabled="{{!selectedCount}}" bindtap="onToActions">已选 {{selectedCount}} · 整理所选 ↓</button></view>
  <checkbox-group bindchange="onSelection"><view wx:if="{{rows.length}}" class="card vocabulary-list"><view wx:for="{{rows}}" wx:key="word" class="vocabulary-row"><view class="vocabulary-word-row"><label><checkbox value="{{item.word}}" checked="{{item.checked}}" disabled="{{busy}}" color="#278de0"/><view><text class="vocabulary-word">{{item.word}}</text><text class="vocabulary-meta">{{item.count}} 次 · {{item.status}}{{item.mastered ? ' · 熟词' : ''}}</text></view></label><button class="text-button" disabled="{{busy}}" data-word="{{item.word}}" bindtap="onWord">查词 ›</button></view><text class="vocabulary-context">{{item.before}}<text>{{item.hit}}</text>{{item.after}}</text><text wx:if="{{item.meaning}}" class="vocabulary-meaning">{{item.meaning}}</text><text wx:if="{{item.matchError}}" class="vocabulary-match-error">{{item.matchError}}</text><button wx:if="{{article}}" class="text-button vocabulary-original" disabled="{{busy}}" data-word="{{item.word}}" bindtap="onOriginal">回到原文</button></view></view></checkbox-group>
  <view wx:if="{{!rows.length}}" class="empty">当前条件下没有候选词，可调整筛选或关闭“隐藏熟词”。</view>
  <view wx:if="{{listPages > 1}}" class="pagination"><button disabled="{{busy || listPage === 0}}" bindtap="onPrev">上一页</button><text>{{listPage + 1}} / {{listPages}}</text><button disabled="{{busy || listPage + 1 === listPages}}" bindtap="onNext">下一页</button></view>
  <view id="vocabulary-actions" class="card vocabulary-actions"><view class="row"><text>已选 {{selectedCount}} / 500</text><button class="text-button" disabled="{{busy || !selectedCount}}" bindtap="onClear">清空选择</button></view><view class="actions"><button disabled="{{busy || !selectedCount}}" bindtap="onResolve">匹配所选释义</button><button class="primary" disabled="{{busy || !readyCount}}" bindtap="onAdd">加入已匹配词 {{readyCount}}</button></view><view wx:if="{{busy}}" class="vocabulary-progress"><text>正在匹配 {{completed}} / {{taskTotal}}</text><button class="text-button" bindtap="onCancel">停止匹配</button></view><text wx:if="{{message}}" class="vocabulary-message">{{message}}</text><view class="vocabulary-deck"><text>学习词表名称</text><input value="{{name}}" maxlength="40" disabled="{{busy}}" bindinput="onName" placeholder="给这份词表起个名字"/></view><button class="vocabulary-create" disabled="{{busy || !selectedCount}}" bindtap="onCreateDeck">{{createdDeck ? '查看已建词表' : '生成学习词表'}}</button><text class="vocabulary-hint">词表保留所选原词形。未匹配到独立词条时，学习页会提示并允许跳过。</text></view>
 </block>
 <view class="footer">每页 25 个候选词；切换筛选会清空选择。提取和匹配不增加学习成绩。</view>
</view>
