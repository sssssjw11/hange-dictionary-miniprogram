.media-status{display:flex;align-items:center;gap:18rpx;margin:18rpx 0;padding:18rpx 22rpx;border:1rpx solid var(--line);border-radius:14rpx;background:var(--soft);color:var(--muted);font-size:23rpx;line-height:1.7}.media-status text{flex:1;min-width:0;overflow-wrap:anywhere}.media-status button{flex:none}.media-list{padding:0 24rpx}.media-row{display:flex;align-items:center;gap:20rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line)}.media-row:last-child{border-bottom:0}.media-copy{flex:1;min-width:0}.media-kind{display:block;color:var(--blue-strong);font-size:21rpx;line-height:1.5}.media-label{display:block;font-size:27rpx;line-height:1.75;margin:6rpx 0;overflow-wrap:anywhere}.page .media-button{flex:none;font-size:23rpx;padding:10rpx 20rpx;border-radius:24rpx;background:var(--paper);color:var(--muted)}.page .media-button.ready{border-color:var(--blue);color:var(--blue-strong);background:var(--soft)}
