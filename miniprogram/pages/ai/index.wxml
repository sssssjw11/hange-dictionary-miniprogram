<view class="page tab-page ai-page {{theme}}">
  <view class="ai-heading"><view><view class="title">AI 学习助手</view><view class="subtitle">用法、句子、写作，聊清楚一点。</view></view><button class="new-chat" bindtap="onNew" aria-label="新建对话">＋</button></view>
  <view class="ai-modes"><button class="{{mode === 'chat' ? 'active' : ''}}" data-mode="chat" bindtap="onMode">问答</button><button class="{{mode === 'explain' ? 'active' : ''}}" data-mode="explain" bindtap="onMode">词句讲解</button><button class="{{mode === 'writing' ? 'active' : ''}}" data-mode="writing" bindtap="onMode">写作批改</button><button class="{{mode === 'summarize' ? 'active' : ''}}" data-mode="summarize" bindtap="onMode">阅读摘要</button></view>
  <view wx:if="{{!available}}" class="setup-notice"><view class="setup-dot"></view><view class="setup-copy"><text>学习助手待连接</text><text>{{reason}}</text></view><button bindtap="onSettings">设置 <text>›</text></button></view>
  <view class="messages"><view wx:for="{{messages}}" wx:key="index" id="message-{{index}}" class="message {{item.role}}"><text class="message-role">{{item.role === 'user' ? '我' : '学习助手'}}</text><text class="message-content" selectable="true">{{item.content}}</text><view wx:if="{{item.incomplete}}" class="small muted">回复达到长度上限，内容未完整结束。</view><button class="text-button" data-index="{{index}}" bindtap="onCopy">复制</button></view>
    <view wx:if="{{!messages.length}}" class="assistant-empty"><view class="assistant-mark"><image src="/assets/ai-on.png"/></view><text class="assistant-title">从一个问题开始</text><text class="assistant-subtitle">也可以先选一个想弄明白的话题。</text><view class="prompt-list"><button data-prompt="affect 和 effect 应该怎么区分？" bindtap="onPrompt"><text>辨析两个易混词</text><text>affect / effect</text><text>↗</text></button><button data-prompt="请用简单的例句讲解定语从句的用法。" bindtap="onPrompt"><text>把语法讲明白</text><text>定语从句的用法</text><text>↗</text></button></view></view>
  </view>
  <view class="compose-card"><textarea class="compose" value="{{input}}" bindinput="onInput" maxlength="6000" placeholder="输入你的问题，或粘贴一段英文…" placeholder-class="muted"/><view class="compose-actions"><text>{{input.length}} / 6000</text><button class="primary" loading="{{busy}}" disabled="{{busy || !available}}" bindtap="onSend">发送 <text>↑</text></button></view></view>
  <view class="chat-tools"><text>回答来自你配置的模型服务</text><button wx:if="{{session}}" disabled="{{busy}}" bindtap="onDelete">删除当前对话</button></view>
  <view wx:if="{{sessions.length}}"><view class="section-head"><text class="section-title">最近对话</text></view><view class="card"><button wx:for="{{sessions}}" wx:key="id" class="word-row" data-id="{{item.id}}" bindtap="onSelect">{{item.title}}</button></view></view>
</view>
