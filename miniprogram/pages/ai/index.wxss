.message{border:1rpx solid var(--line);border-radius:20rpx;padding:26rpx;margin:20rpx 0;background:var(--paper)}.message.user{background:var(--soft);margin-left:35rpx}.message.assistant{margin-right:10rpx}.message-content{display:block;white-space:pre-wrap;line-height:1.9;overflow-wrap:anywhere;margin:10rpx 0}.compose{height:240rpx;line-height:1.8}.active.chip{border-color:var(--blue);background:var(--soft)}.messages{margin:20rpx 0}
