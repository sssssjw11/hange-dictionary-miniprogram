.ai-heading{display:flex;justify-content:space-between;align-items:center;gap:18rpx;margin:8rpx 0 28rpx}.ai-heading>view{min-width:0}.ai-heading .subtitle{font-size:23rpx}.new-chat{border:0;background:var(--soft);color:var(--blue-strong);border-radius:50%;width:62rpx!important;height:62rpx;min-width:62rpx;padding:0;font-size:38rpx;line-height:62rpx;flex:none}.ai-modes{display:flex;gap:8rpx;border-radius:16rpx;background:var(--line);padding:6rpx}.page .ai-modes button{flex:1;min-width:0;width:0;border:0;padding:14rpx 3rpx;border-radius:12rpx;font-size:24rpx;background:transparent;color:var(--muted)}.page .ai-modes button.active{background:var(--paper);color:var(--blue-strong);box-shadow:0 2rpx 8rpx #34495a08}
.setup-notice{display:flex;align-items:flex-start;gap:13rpx;padding:21rpx 20rpx;border-radius:18rpx;background:var(--soft);margin:23rpx 0}.setup-dot{width:8rpx;height:8rpx;border-radius:50%;background:var(--blue);margin-top:13rpx;flex:none}.setup-copy{display:flex;flex-direction:column;gap:5rpx;flex:1;min-width:0;overflow-wrap:anywhere}.setup-copy>text:first-child{font-size:25rpx;color:#6289a8}.setup-copy>text:last-child{font-size:21rpx;color:var(--muted)}.setup-notice button{flex:none;padding:5rpx 0;border:0;background:none;font-size:23rpx;color:var(--blue-strong)}.setup-notice button text{margin-left:8rpx}
.assistant-empty{display:flex;flex-direction:column;align-items:center;padding:35rpx 0 25rpx}.assistant-mark{display:flex;align-items:center;justify-content:center;width:91rpx;height:91rpx;border-radius:27rpx;background:var(--soft);margin-bottom:22rpx}.assistant-mark image{width:54rpx;height:54rpx}.assistant-title{font-size:32rpx;color:#586f83;font-weight:500}.assistant-subtitle{font-size:23rpx;color:var(--muted);margin-top:8rpx}.prompt-list{display:flex;gap:16rpx;width:100%;margin-top:27rpx}.page .prompt-list button{position:relative;flex:1;min-width:0;width:0;padding:21rpx 20rpx;border-radius:18rpx;border-color:var(--line);background:var(--paper);text-align:left}.prompt-list button text{display:block;font-size:24rpx;color:#68859d}.prompt-list button text:nth-child(2){font-size:21rpx;color:var(--muted);margin-top:8rpx}.prompt-list button text:last-child{position:absolute;right:16rpx;top:17rpx;color:#a4b8c9;font-size:25rpx}
.messages{margin:24rpx 0}.message{max-width:96%;padding:24rpx 27rpx;border:1rpx solid var(--line);border-radius:20rpx;background:var(--paper);margin:18rpx 0;overflow-wrap:anywhere}.message.user{margin-left:auto;background:var(--soft);border-color:transparent}.message-role{display:block;font-size:21rpx;color:var(--muted);margin-bottom:10rpx}.message-content{display:block;white-space:pre-wrap;line-height:1.85;font-size:28rpx}.message .text-button{display:block;margin-top:14rpx;font-size:21rpx}.compose-card{border:1rpx solid #dce7f0;border-radius:22rpx;background:var(--paper);padding:22rpx 23rpx 16rpx;margin-top:8rpx;box-shadow:0 6rpx 24rpx #1e4a6d04}.compose{display:block;width:100%;height:150rpx;min-height:150rpx;border:0;background:transparent;color:var(--ink);font-size:27rpx;line-height:1.65}.compose-actions{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:13rpx}.compose-actions>text{font-size:20rpx;color:#b2bcc7}.compose-actions button{font-size:26rpx;padding:13rpx 24rpx;border-radius:16rpx;min-width:128rpx}.compose-actions button text{margin-left:12rpx;font-size:26rpx}.chat-tools{display:flex;align-items:center;justify-content:space-between;gap:14rpx;color:#a7b1bc;font-size:20rpx;margin:16rpx 3rpx}.chat-tools button{border:0;background:none;font-size:20rpx;color:var(--muted);padding:3rpx 0}
.dark .assistant-title{color:#c7d6e5}.dark .setup-copy>text:first-child{color:#adcee9}.dark .compose-card{border-color:#34475c}.dark .prompt-list button text{color:#b2c8db}
@media(min-width:700px){.ai-heading .subtitle{font-size:14px}.page .ai-modes button{font-size:15px}.setup-copy>text:first-child{font-size:15px}.setup-copy>text:last-child{font-size:13px}.setup-notice button{font-size:14px}.assistant-title{font-size:21px}.assistant-subtitle{font-size:14px}.prompt-list button text{font-size:15px}.prompt-list button text:nth-child(2){font-size:13px}.message-content,.compose{font-size:16px}.compose{height:100px;min-height:100px}.compose-actions>text,.chat-tools,.chat-tools button{font-size:12px}.compose-actions button{font-size:15px}}
