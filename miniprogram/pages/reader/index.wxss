.reader-title{font-size:43rpx;font-weight:700;margin:16rpx 0;word-break:break-word}.reader-actions{display:flex;gap:12rpx;margin:24rpx 0}.reader-actions button{flex:1;padding:10rpx 8rpx;font-size:23rpx;color:var(--blue)}.reading-body{padding:35rpx 28rpx;line-height:2.05;white-space:pre-wrap;overflow-wrap:anywhere}.read-word:active{background:var(--soft);color:var(--blue)}.lookup-mask{position:fixed;inset:0;background:#10253677;z-index:50}.lookup-sheet{position:fixed;bottom:0;left:0;right:0;z-index:51;background:var(--paper);border-radius:28rpx 28rpx 0 0;padding:34rpx 32rpx calc(38rpx + env(safe-area-inset-bottom));box-shadow:0 -8rpx 40rpx #10253622}.popup-meaning{font-size:29rpx;line-height:1.85;max-height:40vh;overflow-y:auto;white-space:pre-line;margin-top:18rpx}
.selection-card{padding:24rpx;margin:22rpx 0;white-space:pre-wrap;overflow-wrap:anywhere}.selection-card .actions{margin-bottom:0}.mark-yellow{background:#f5c74866}.mark-green{background:#53b58955}.mark-blue{background:#409de355}.range-selected{background:#409de388;border-bottom:2rpx solid var(--blue)}.dark .mark-yellow{background:#a68a2c66}.dark .mark-green{background:#3d9b7866}.dark .mark-blue{background:#286a9f77}.lookup-sheet .word{max-width:80%;overflow-wrap:anywhere}.reader-actions button{min-width:0}
.reader-audio{margin:24rpx 0 18rpx;padding:20rpx;border:1rpx solid var(--line);border-radius:18rpx;background:var(--paper)}.reader-audio-actions{display:flex;gap:14rpx}.page .reader-audio-actions button{flex:1;min-width:0;padding:13rpx 10rpx;border:1rpx solid var(--line);border-radius:15rpx;background:var(--soft);color:var(--blue-strong);font-size:27rpx}.page .reader-audio-actions button.active{color:var(--paper);background:var(--blue-strong);border-color:var(--blue-strong)}.reader-audio-hint,.reader-audio-status,.reader-audio-error{display:block;margin-top:12rpx;color:var(--muted);font-size:24rpx;line-height:1.7;overflow-wrap:anywhere}.reader-audio-status{color:var(--blue-strong)}.reader-audio-error{color:#bd635a}
