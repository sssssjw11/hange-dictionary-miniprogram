<view class="page {{theme}} {{searchOpen && searchTotal ? 'reader-finding' : ''}}">
 <view class="reader-title">{{title}}</view><view wx:if="{{error}}" class="info">{{error}}</view>
 <view wx:if="{{total}}" class="reader-audio"><view class="reader-audio-actions"><button class="{{reading && !readContinuous ? 'active' : ''}}" bindtap="onSpeak">{{reading && !readContinuous ? '停止朗读' : '朗读本页'}}</button><button class="{{reading && readContinuous ? 'active' : ''}}" bindtap="onReadAll">{{reading && readContinuous ? '停止连读' : '连续朗读'}}</button></view><text class="reader-audio-hint">连续朗读从当前页继续，读完后自动翻页。</text><text wx:if="{{readStatus}}" class="reader-audio-status">{{readStatus}}</text><text wx:if="{{readError}}" class="reader-audio-error">{{readError}}</text></view>
 <view wx:if="{{total}}" class="reader-actions"><button bindtap="onSearchOpen">全文查找</button><button bindtap="onTranslate">本页翻译</button><button bindtap="onSavePassage">收藏段落</button><button bindtap="onVocabulary">提取单词</button></view>
 <view wx:if="{{total}}" class="reader-actions"><button bindtap="onMarkMode">{{markMode ? '结束选段' : '选段标注'}}</button><button bindtap="onBookmark">{{bookmarked ? '移除本页书签' : '添加书签'}}</button><button bindtap="onAnnotations">批注 / 书签 {{annotationsCount}}</button></view>
 <view wx:if="{{markMode}}" class="info">依次点选起点和终点，可翻页选取。长按一个词也能直接保存标注。</view>
 <view wx:if="{{hasSelection}}" class="card selection-card"><view class="small muted">已选 {{selectionLength}} 字符</view><text>{{selectionQuote}}{{selectionLength > 120 ? '…' : ''}}</text><view class="actions"><button disabled="{{selectionLength > 256}}" bindtap="onSelectedLookup">查所选词句</button><button class="primary" disabled="{{selectionLength > 6000}}" bindtap="onSaveSelection">保存批注</button></view></view>
 <view wx:if="{{searchOpen}}" id="reader-search" class="card reader-search"><view class="row"><text class="reader-search-title">全文查找</text><button class="text-button" bindtap="onSearchClose">关闭</button></view><view class="reader-search-input"><input value="{{searchQuery}}" maxlength="256" placeholder="输入单词、短语或中文" confirm-type="search" bindinput="onSearchInput" bindconfirm="onSearchRun"/><button bindtap="onSearchRun">查找</button></view><text wx:if="{{searchError}}" class="reader-search-hint reader-search-error">{{searchError}}</text><text wx:elif="{{searchTotal}}" class="reader-search-hint">找到 {{searchTotal}} 处，可用底部按钮切换。</text></view>
 <view class="reading-body card" style="font-size:{{fontSize}}px"><text wx:for="{{tokens}}" wx:key="id" id="reader-token-{{item.start}}" class="{{item.word ? 'read-word' : ''}} {{item.color ? 'mark-' + item.color : ''}} {{item.selected ? 'range-selected' : ''}} {{item.searchMatch ? 'reader-search-hit' : ''}}" data-start="{{item.start}}" data-end="{{item.end}}" data-word-start="{{item.wordStart}}" data-word-end="{{item.wordEnd}}" bindtap="onToken" bindlongpress="onTokenLong">{{item.text}}</text></view>
 <view wx:if="{{total}}" class="pagination"><button disabled="{{page === 0}}" bindtap="onPrev">上一页</button><text>{{page + 1}} / {{total}}</text><button disabled="{{page + 1 === total}}" bindtap="onNext">下一页</button></view>
 <view wx:if="{{searchOpen && searchTotal}}" class="reader-search-nav"><button disabled="{{searchIndex === 0}}" bindtap="onSearchPrev">上一处</button><text>{{searchIndex + 1}} / {{searchTotal}}</text><button disabled="{{searchIndex + 1 === searchTotal}}" bindtap="onSearchNext">下一处</button><button class="reader-search-close" bindtap="onSearchClose">关闭</button></view>
 <view wx:if="{{popup}}" class="lookup-mask" bindtap="onClose"></view><view wx:if="{{popup}}" class="lookup-sheet"><view class="row"><text class="word">{{word}}</text><button class="text-button" bindtap="onClose">关闭</button></view><view class="popup-meaning">{{looking ? '正在查词…' : meaning}}</view><view class="actions"><button class="primary" bindtap="onDetail">完整释义</button><button disabled="{{looking || !canFavorite}}" bindtap="onFavorite">加入生词本</button></view><view class="actions"><button bindtap="onAnnotate">{{hasCurrentMark ? '编辑本处批注' : '高亮 / 批注'}}</button><button disabled="{{looking || !canFavorite}}" bindtap="onGroups">生词本分组</button></view></view>
 <group-picker visible="{{groupPicker}}" word="{{groupWord}}" meaning="{{groupMeaning}}" theme="{{theme}}" bindsave="onGroupSaved" bindclose="onGroupClose"/>
</view>
