<view class="page {{theme}}"><text class="eyebrow">TAP A WORD TO LOOK IT UP</text><view class="reader-title">{{title}}</view><view wx:if="{{error}}" class="info">{{error}}</view><view class="reader-actions"><button bindtap="onSpeak">朗读本页</button><button bindtap="onTranslate">本页翻译</button><button bindtap="onSavePassage">收藏段落</button></view><view class="reading-body card" style="font-size:{{fontSize}}px"><text wx:for="{{tokens}}" wx:key="id" class="{{item.word ? 'read-word' : ''}}" data-word="{{item.word}}" bindtap="onWord">{{item.text}}</text></view><view class="pagination"><button disabled="{{page === 0}}" bindtap="onPrev">上一页</button><text>{{page+1}} / {{total}}</text><button disabled="{{page+1 === total}}" bindtap="onNext">下一页</button></view><view wx:if="{{popup}}" class="lookup-mask" bindtap="onClose"></view><view wx:if="{{popup}}" class="lookup-sheet"><view class="row"><text class="word">{{word}}</text><button class="text-button" bindtap="onClose">关闭</button></view><view class="popup-meaning">{{looking ? '正在查词…' : meaning}}</view><view class="actions"><button class="primary" bindtap="onDetail">完整释义</button><button disabled="{{looking}}" bindtap="onFavorite">加入生词本</button></view></view></view>
