<view class="page {{theme}}">
 <text class="eyebrow">READ, NOTICE, REMEMBER</text><view class="reader-title">{{title}}</view><view wx:if="{{error}}" class="info">{{error}}</view>
 <view wx:if="{{total}}" class="reader-actions"><button bindtap="onSpeak">朗读本页</button><button bindtap="onTranslate">本页翻译</button><button bindtap="onSavePassage">收藏段落</button></view>
 <view wx:if="{{total}}" class="reader-actions"><button bindtap="onMarkMode">{{markMode ? '结束选段' : '选段标注'}}</button><button bindtap="onBookmark">{{bookmarked ? '移除本页书签' : '添加书签'}}</button><button bindtap="onAnnotations">批注 / 书签 {{annotationsCount}}</button></view>
 <view wx:if="{{markMode}}" class="info">依次点选起点和终点，可翻页选取。长按一个词也能直接保存标注。</view>
 <view wx:if="{{hasSelection}}" class="card selection-card"><view class="small muted">已选 {{selectionLength}} 字符</view><text>{{selectionQuote}}{{selectionLength > 120 ? '…' : ''}}</text><view class="actions"><button disabled="{{selectionLength > 256}}" bindtap="onSelectedLookup">查所选词句</button><button class="primary" disabled="{{selectionLength > 6000}}" bindtap="onSaveSelection">保存批注</button></view></view>
 <view class="reading-body card" style="font-size:{{fontSize}}px"><text wx:for="{{tokens}}" wx:key="id" id="reader-token-{{item.start}}" class="{{item.word ? 'read-word' : ''}} {{item.color ? 'mark-' + item.color : ''}} {{item.selected ? 'range-selected' : ''}}" data-start="{{item.start}}" data-end="{{item.end}}" data-word-start="{{item.wordStart}}" data-word-end="{{item.wordEnd}}" bindtap="onToken" bindlongpress="onTokenLong">{{item.text}}</text></view>
 <view wx:if="{{total}}" class="pagination"><button disabled="{{page === 0}}" bindtap="onPrev">上一页</button><text>{{page + 1}} / {{total}}</text><button disabled="{{page + 1 === total}}" bindtap="onNext">下一页</button></view>
 <view wx:if="{{popup}}" class="lookup-mask" bindtap="onClose"></view><view wx:if="{{popup}}" class="lookup-sheet"><view class="row"><text class="word">{{word}}</text><button class="text-button" bindtap="onClose">关闭</button></view><view class="popup-meaning">{{looking ? '正在查词…' : meaning}}</view><view class="actions"><button class="primary" bindtap="onDetail">完整释义</button><button disabled="{{looking || !canFavorite}}" bindtap="onFavorite">加入生词本</button></view><view class="actions"><button bindtap="onAnnotate">{{hasCurrentMark ? '编辑本处批注' : '高亮 / 批注'}}</button><button disabled="{{looking || !canFavorite}}" bindtap="onGroups">生词本分组</button></view></view>
 <group-picker visible="{{groupPicker}}" word="{{groupWord}}" meaning="{{groupMeaning}}" theme="{{theme}}" bindsave="onGroupSaved" bindclose="onGroupClose"/>
</view>
