.statistics-heading{display:flex;justify-content:space-between;align-items:center;gap:20rpx;margin:10rpx 0 26rpx}.statistics-heading .title{margin:6rpx 0}.statistics-heading .text-button{flex-shrink:0;font-size:25rpx}.statistics-date{display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin-bottom:22rpx;padding:20rpx 24rpx;border:1rpx solid var(--line);border-radius:18rpx;background:var(--paper);font-size:29rpx;font-weight:600}.statistics-date>text:last-child{font-size:24rpx;font-weight:400;color:var(--blue-strong)}.statistics-summary{padding:28rpx;background:linear-gradient(130deg,var(--soft),var(--paper) 85%)}.statistics-total>text{font-size:25rpx;color:var(--muted)}.statistics-total>text:last-child{font-size:23rpx}.statistics-total>view{font-size:68rpx;line-height:1.3;color:var(--blue-strong);font-weight:600;margin:8rpx 0}.statistics-total>view>text{font-size:25rpx;font-weight:400;color:var(--muted);margin-left:10rpx}.statistics-metrics{display:grid;grid-template-columns:1fr 1fr;gap:24rpx 20rpx;margin-top:28rpx;padding-top:24rpx;border-top:1rpx solid var(--line)}.statistics-metrics>view{display:flex;flex-direction:column;gap:7rpx;min-width:0;overflow-wrap:anywhere}.statistics-metrics>view>text:first-child{font-size:33rpx;font-weight:600}.statistics-metrics>view>text:last-child{font-size:24rpx;color:var(--muted)}.statistics-period{display:flex;gap:8rpx}.page .statistics-period button{padding:7rpx 16rpx;border-radius:12rpx;font-size:24rpx;background:transparent;color:var(--muted)}.page .statistics-period button.selected,.page .statistics-filters button.selected{color:var(--blue-strong);border-color:var(--blue);background:var(--soft)}.statistics-trend{padding:24rpx 14rpx}.statistics-trend scroll-view{width:100%}.statistics-chart{display:flex;align-items:flex-end;padding:6rpx 0 0}.statistics-day{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:10rpx;font-size:21rpx;color:var(--muted);font-variant-numeric:tabular-nums}.statistics-chart-track{height:154rpx;display:flex;align-items:flex-end;border-bottom:2rpx solid var(--line);width:28rpx}.statistics-chart-track>view{width:100%;background:#94c4e8;border-radius:5rpx 5rpx 0 0}.statistics-day.current{color:var(--blue-strong)}.current .statistics-chart-track>view{background:var(--blue)}.statistics-trend-note{margin:20rpx 8rpx 0;font-size:24rpx;line-height:1.7;color:var(--muted);overflow-wrap:anywhere}.statistics-filters{display:flex;gap:12rpx;margin-bottom:18rpx}.page .statistics-filters button{flex:1;min-width:0;padding:12rpx 6rpx;border-radius:15rpx;font-size:25rpx;color:var(--muted)}.statistics-history-note{margin:18rpx 0;font-size:24rpx;line-height:1.7;color:var(--muted)}.statistics-log-row{display:flex;align-items:center;gap:18rpx;padding:22rpx}.statistics-log-row+.statistics-log-row{border-top:1rpx solid var(--line)}.statistics-log-main{flex:1;min-width:0}.page .statistics-word{display:flex;align-items:center;gap:10rpx;padding:0;border:0;border-radius:0;background:transparent;text-align:left;color:var(--ink);font-size:32rpx;overflow-wrap:anywhere}.statistics-word>text{font-size:26rpx;color:var(--blue-strong);flex-shrink:0}.statistics-log-main>text{display:block;margin-top:8rpx;font-size:23rpx;color:var(--muted);line-height:1.7;overflow-wrap:anywhere}.statistics-grade{flex-shrink:0;padding:7rpx 13rpx;border-radius:10rpx;background:var(--soft);color:var(--blue-strong);font-size:24rpx}.grade-again,.grade-hard{background:#f8eee2;color:#a16b32}.dark .grade-again,.dark .grade-hard{background:#46382a;color:#efc58e}.statistics-empty{padding:45rpx 20rpx;text-align:center;font-size:27rpx;color:var(--muted)}
