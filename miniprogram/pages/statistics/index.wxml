<view class="page statistics-page {{theme}}">
 <view class="statistics-heading"><view><text class="eyebrow">每一次回忆，都算数</text><view class="title">学习记录</view></view><button class="text-button" bindtap="onToday">回到今天</button></view>
 <view wx:if="{{error}}" class="info">{{error}}</view>
 <picker mode="date" value="{{date}}" start="{{start}}" end="{{today}}" bindchange="onDate"><view class="statistics-date"><text>{{date}}</text><text>{{date === today ? '今天 · ' : ''}}选择日期　⌄</text></view></picker>
 <view class="card statistics-summary"><view class="statistics-total"><text>已提交</text><view>{{selected.attempts || 0}}<text>次</text></view><text>跳过与朗读不计入</text></view><view class="statistics-metrics"><view><text>{{selected.new || 0}}</text><text>新学次数</text></view><view><text>{{selected.review || 0}}</text><text>复习次数</text></view><view><text>{{selected.rate}}</text><text>回忆成功率</text></view><view><text>{{selected.duration}}</text><text>答题计时</text></view></view></view>
 <view class="section-head"><text class="section-title">近期趋势</text><view class="statistics-period"><button class="{{period === 7 ? 'selected' : ''}}" data-period="7" bindtap="onPeriod">7 天</button><button class="{{period === 30 ? 'selected' : ''}}" data-period="30" bindtap="onPeriod">30 天</button></view></view>
 <view class="card statistics-trend"><scroll-view scroll-x="{{true}}" scroll-into-view="statistics-day-{{days.length - 1}}"><view class="statistics-chart" style="width:{{period === 30 ? '1800rpx' : '100%'}}"><view wx:for="{{days}}" wx:key="date" id="statistics-day-{{index}}" class="statistics-day {{item.date === date ? 'current' : ''}}"><text>{{item.count}}</text><view class="statistics-chart-track"><view style="height:{{item.height}}rpx"></view></view><text>{{item.label}}</text></view></view></scroll-view><view class="statistics-trend-note">截至所选日期的 {{period}} 天：提交 {{summary.attempts || 0}} 次，计时 {{summary.duration}}。</view></view>
 <view class="section-head"><text class="section-title">逐次明细</text><text class="small muted">{{recorded}} 条记录</text></view>
 <view class="statistics-filters"><button class="{{filter === 'all' ? 'selected' : ''}}" data-filter="all" bindtap="onFilter">全部</button><button class="{{filter === 'again' ? 'selected' : ''}}" data-filter="again" bindtap="onFilter">需巩固</button><button class="{{filter === 'new' ? 'selected' : ''}}" data-filter="new" bindtap="onFilter">新学</button><button class="{{filter === 'review' ? 'selected' : ''}}" data-filter="review" bindtap="onFilter">复习</button></view>
 <view wx:if="{{partial}}" class="statistics-history-note">当日部分提交只有汇总数据。逐词明细从支持此功能的版本开始记录，保留最近 {{historyLimit}} 次。</view>
 <view wx:if="{{rows.length}}" class="card statistics-log"><view wx:for="{{rows}}" wx:key="id" class="statistics-log-row"><view class="statistics-log-main"><button class="statistics-word" data-word="{{item.word}}" bindtap="onWord">{{item.word}}<text>›</text></button><text>{{item.time}} · {{item.modeLabel}} · {{item.first ? '新学' : '复习'}} · {{item.duration}}</text></view><text class="statistics-grade grade-{{item.grade}}">{{item.gradeLabel}}</text></view></view>
 <view wx:else class="statistics-empty">{{selected.attempts ? '当前筛选下没有逐词记录' : '这一天还没有提交学习记录'}}</view>
 <view wx:if="{{pages > 1}}" class="pagination"><button disabled="{{page === 0}}" bindtap="onPrev">上一页</button><text>{{page + 1}} / {{pages}}</text><button disabled="{{page + 1 === pages}}" bindtap="onNext">下一页</button></view>
 <view class="footer">回忆成功率按提交评分统计；“需巩固”包含忘记与困难。</view>
</view>
