.notebook-page{background:var(--paper)}.notebook-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin:8rpx 0 34rpx}.notebook-heading>view{min-width:0}.notebook-heading .subtitle{font-size:23rpx}.manage-books{display:flex;align-items:center;gap:8rpx;flex:none;padding:11rpx 17rpx;border:0;border-radius:22rpx;background:var(--soft);color:var(--blue-strong);font-size:24rpx}.manage-books image{width:28rpx;height:28rpx}
.book-filter{margin:10rpx 0 20rpx}.book-filter picker{display:block}.book-value{display:flex;align-items:center;gap:12rpx;padding:20rpx 22rpx;border:1rpx solid var(--line);border-radius:18rpx;font-size:27rpx}.book-value image{height:31rpx;width:31rpx;flex:none}.book-value>text:nth-child(2){flex:1;min-width:0;overflow-wrap:anywhere}.book-chevron{color:var(--muted);font-size:30rpx}
.notebook-search{display:flex;align-items:center;gap:14rpx;background:var(--bg);border-radius:18rpx;padding:0 22rpx;min-height:80rpx}.notebook-search image{width:29rpx;height:29rpx;opacity:.8;flex:none}.notebook-search input{flex:1;min-width:0;height:80rpx;font-size:26rpx;color:var(--ink)}
.notebook-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:32rpx 0 12rpx;font-size:24rpx;color:var(--muted)}.notebook-toolbar>view{display:flex;gap:24rpx}.notebook-toolbar button{border:0;padding:4rpx 0;background:none;font-size:24rpx;color:var(--muted)}.notebook-toolbar .toolbar-emphasis{color:var(--blue-strong)}
.notebook-row{border-bottom:1rpx solid var(--line)}.notebook-row .word-row{padding:25rpx 0 14rpx}.note-preview{white-space:pre-line;max-height:142rpx;overflow:hidden;font-size:24rpx}.word-tools{padding:0 0 22rpx;gap:16rpx}.word-tools>text{min-width:0;overflow-wrap:anywhere;font-size:22rpx;color:#a4adb8}.word-tools button{flex:none;font-size:22rpx}.word-tools button text{margin-left:9rpx}.select-word{display:flex;gap:18rpx;padding:26rpx 0;align-items:center}.select-word view{min-width:0;flex:1}
.notebook-empty{display:flex;flex-direction:column;align-items:center;text-align:center;padding:78rpx 28rpx 48rpx}.empty-icon{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;border-radius:32rpx;background:var(--soft);margin-bottom:26rpx}.empty-icon image{width:55rpx;height:55rpx;opacity:.85}.empty-heading{font-size:31rpx;color:#6f8192}.empty-copy{font-size:24rpx;line-height:1.8;color:var(--muted);margin-top:12rpx;max-width:480rpx}.empty-action{border:0;background:transparent;color:var(--blue-strong);font-size:26rpx;margin-top:22rpx;padding:12rpx}.empty-action text{margin-left:10rpx}.dark .empty-heading{color:#c0d0df}
@media(min-width:700px){.notebook-heading .subtitle{font-size:14px}.manage-books,.book-value{font-size:16px}.notebook-search input{font-size:15px}.book-value,.notebook-search{min-height:44px}.notebook-toolbar,.notebook-toolbar button{font-size:14px}.empty-heading{font-size:20px}.empty-copy{font-size:15px;max-width:360px}.empty-action{font-size:15px}}
