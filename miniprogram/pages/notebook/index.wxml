<view class="page {{theme}}">
 <view class="page-heading"><text class="eyebrow">YOUR WORDS</text><view class="title">生词本 <text class="small muted">{{count}} 个词</text></view><view class="subtitle">分类、收藏和笔记保存在这台设备上。</view></view>
 <view class="book-filter row"><picker mode="selector" range="{{books}}" range-key="label" value="{{bookIndex}}" bindchange="onBook"><view class="field">{{books[bookIndex].label}} ▾</view></picker><button class="text-button" bindtap="onManage">管理</button></view>
 <input class="field" value="{{query}}" placeholder="搜索单词、释义或笔记" placeholder-class="muted" bindinput="onInput"/>
 <view class="actions"><button bindtap="onExport">导出本表 JSON</button><button bindtap="onImport">导入 JSON</button><button bindtap="onToggleSelect">{{selecting ? '结束多选' : '多选整理'}}</button></view>
 <view wx:if="{{selecting}}" class="actions"><button bindtap="onSelectPage">选择 / 取消本页</button><button class="primary" disabled="{{!selectedCount}}" bindtap="onAssignSelection">分组 {{selectedCount}} 词</button></view>
 <view class="card"><checkbox-group bindchange="onSelection"><view wx:for="{{rows}}" wx:key="word" class="notebook-row">
  <label wx:if="{{selecting}}" class="select-word"><checkbox value="{{item.word}}" checked="{{item.checked}}" color="#267fbb"/><view><text class="word">{{item.word}}</text><text class="meaning">{{item.meaning}}</text></view></label>
  <button wx:else class="word-row" data-word="{{item.word}}" bindtap="onWord"><text class="word">{{item.word}}</text><text class="meaning">{{item.meaning}}</text><text wx:if="{{item.note}}" class="note-preview">笔记：{{item.note}}</text></button>
  <view wx:if="{{!selecting}}" class="word-tools row"><text class="small muted">{{item.bookNames || '未分组'}}</text><button class="text-button" data-word="{{item.word}}" bindtap="onAssign">分组</button></view>
 </view></checkbox-group><view wx:if="{{!rows.length}}" class="empty">{{query ? '没有匹配的收藏，换个关键词试试。' : '这个生词本还没有单词。查词后可收藏并选择归属。'}}</view></view>
 <view wx:if="{{listPages > 1}}" class="actions pagination"><button disabled="{{listPage === 0}}" bindtap="onPrev">上一页</button><text>{{listPage + 1}} / {{listPages}}</text><button disabled="{{listPage + 1 >= listPages}}" bindtap="onNext">下一页</button></view>
 <view class="footer">此处导出当前生词本的平面 JSON，兼容 Android 本地版。保留全部分组结构请使用“完整备份”。已有单词的个人笔记在导入时会保留。</view>
 <group-picker visible="{{groupPicker}}" word="{{groupingWord}}" words="{{groupingWords}}" meaning="{{groupingMeaning}}" theme="{{theme}}" bindsave="onGroupSaved" bindclose="onGroupClose"/>
</view>
