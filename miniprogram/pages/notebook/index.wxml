<view class="page tab-page notebook-page {{theme}}">
  <view class="notebook-heading"><view><view class="title">生词笔记</view><text class="subtitle">{{count}} 个收藏，把每个词慢慢记牢。</text></view><button class="manage-books" bindtap="onManage"><image src="/assets/bookmark-on.png"/><text>管理</text></button></view>
  <view class="book-filter"><picker mode="selector" range="{{books}}" range-key="label" value="{{bookIndex}}" bindchange="onBook"><view class="book-value"><image src="/assets/study-on.png"/><text>{{books[bookIndex].label}}</text><text class="book-chevron">⌄</text></view></picker></view>
  <view class="notebook-search"><image src="/assets/search.png"/><input value="{{query}}" placeholder="搜索单词、释义或笔记" placeholder-class="muted" bindinput="onInput"/></view>
  <view class="notebook-toolbar"><text>{{selecting ? '已选 '+selectedCount+' 个词' : '我的收藏'}}</text><view><button bindtap="onImport">导入</button><button bindtap="onExport">导出</button><button class="toolbar-emphasis" bindtap="onToggleSelect">{{selecting ? '完成' : '多选'}}</button></view></view>
  <view wx:if="{{selecting}}" class="actions"><button bindtap="onSelectPage">选择 / 取消本页</button><button class="primary" disabled="{{!selectedCount}}" bindtap="onAssignSelection">整理 {{selectedCount}} 个词</button></view>
  <view class="notebook-list"><checkbox-group bindchange="onSelection"><view wx:for="{{rows}}" wx:key="word" class="notebook-row">
    <label wx:if="{{selecting}}" class="select-word"><checkbox value="{{item.word}}" checked="{{item.checked}}" color="{{accent}}"/><view><text class="word">{{item.word}}</text><text class="meaning">{{item.meaning}}</text></view></label>
    <button wx:else class="word-row" data-word="{{item.word}}" bindtap="onWord"><text class="word">{{item.word}}</text><text class="meaning">{{item.meaning}}</text><text wx:if="{{item.note}}" class="note-preview">{{item.note}}</text></button>
    <view wx:if="{{!selecting}}" class="word-tools row"><text>{{item.bookNames || '未分组'}}</text><button class="text-button" data-word="{{item.word}}" bindtap="onAssign">分组 <text>›</text></button></view>
  </view></checkbox-group></view>
  <view wx:if="{{!rows.length}}" class="notebook-empty"><view class="empty-icon"><image src="/assets/bookmark-on.png"/></view><text class="empty-heading">{{query ? '没有找到这个词' : '留住每一次收获'}}</text><text class="empty-copy">{{query ? '换个关键词，或者看看其他生词本。' : '查词时点一下收藏，就能在这里写笔记、分组和复习。'}}</text><button wx:if="{{!query}}" class="empty-action" bindtap="onLookup">去查一个词 <text>›</text></button></view>
  <view wx:if="{{listPages > 1}}" class="pagination"><button disabled="{{listPage === 0}}" bindtap="onPrev">上一页</button><text>{{listPage + 1}} / {{listPages}}</text><button disabled="{{listPage + 1 >= listPages}}" bindtap="onNext">下一页</button></view>
  <view wx:if="{{rows.length}}" class="footer">导出当前生词本；全部分类和学习进度可在“完整备份”中保存。</view>
  <group-picker visible="{{groupPicker}}" word="{{groupingWord}}" words="{{groupingWords}}" meaning="{{groupingMeaning}}" theme="{{theme}}" bindsave="onGroupSaved" bindclose="onGroupClose"/>
</view>
