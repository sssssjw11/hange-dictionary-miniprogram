<view class="page {{theme}}"><view class="title">批注与书签</view><input class="field" value="{{query}}" bindinput="onInput" placeholder="搜索原文、笔记或材料标题"/><view class="chips annotation-filters"><button class="chip" data-kind="all" bindtap="onKind">{{kind === 'all' ? '✓ ' : ''}}全部</button><button class="chip" data-kind="highlight" bindtap="onKind">{{kind === 'highlight' ? '✓ ' : ''}}高亮 / 批注</button><button class="chip" data-kind="bookmark" bindtap="onKind">{{kind === 'bookmark' ? '✓ ' : ''}}书签</button></view><view class="small muted">共 {{total}} 条</view><view wx:for="{{rows}}" wx:key="key" class="card annotation-summary"><view class="row"><text class="small muted">{{item.title}}</text><text class="small muted">{{item.kind === 'bookmark' ? '书签' : '批注'}}</text></view><text class="annotation-excerpt {{item.color}}">{{item.quote}}{{item.quoteLength > 180 ? '…' : ''}}</text><text wx:if="{{item.note}}" class="annotation-preview">{{item.note}}{{item.noteLength > 240 ? '…' : ''}}</text><view class="actions"><button data-start="{{item.start}}" data-article="{{item.articleId}}" bindtap="onJump">回到原文</button><button data-id="{{item.id}}" data-article="{{item.articleId}}" bindtap="onEdit">编辑完整批注</button></view></view><view wx:if="{{!rows.length}}" class="empty">在阅读页长按文字或选定范围，即可保存高亮、批注和书签。</view><view wx:if="{{listPages > 1}}" class="pagination"><button disabled="{{listPage === 0}}" bindtap="onPrev">上一页</button><text>{{listPage + 1}} / {{listPages}}</text><button disabled="{{listPage + 1 >= listPages}}" bindtap="onNext">下一页</button></view></view>
