.annotation-filters{margin:24rpx 0}.annotation-summary{padding:26rpx;margin:24rpx 0}.annotation-summary .row{align-items:flex-start;overflow-wrap:anywhere}.annotation-summary .row text:first-child{flex:1;min-width:0}.annotation-summary .row text:last-child{flex:none}.annotation-excerpt{display:block;white-space:pre-wrap;overflow-wrap:anywhere;font-size:29rpx;margin:20rpx 0;padding-left:18rpx;border-left:6rpx solid #d4b04a}.annotation-excerpt.green{border-color:#53b589}.annotation-excerpt.blue{border-color:#409de3}.annotation-preview{display:block;font-size:25rpx;color:var(--muted);white-space:pre-wrap;overflow-wrap:anywhere}.annotation-summary .actions{margin-bottom:0}
