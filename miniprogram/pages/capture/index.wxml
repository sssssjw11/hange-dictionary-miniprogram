<view class="page {{theme}}"><view class="title">{{preferred === 'voice' ? '语音查词' : '拍照识词'}}</view><view class="subtitle">把看见、听见的词，变成自己的积累。</view>
  <view class="capture-choices"><button class="capture-choice {{preferred === 'photo' ? 'active' : ''}}" disabled="{{busy || recording}}" bindtap="onPhoto"><image src="/assets/camera-on.png"/><text>选择图片</text><text>选图后可编辑、裁剪</text></button><button class="capture-choice {{preferred === 'voice' ? 'active' : ''}}" disabled="{{busy}}" bindtap="onRecord"><image src="/assets/mic-on.png"/><text>{{recording ? '结束录音 '+seconds+'s' : '语音输入'}}</text><text>{{recording ? '点击结束，最长60秒' : '点击开始录音'}}</text></button></view>
  <view wx:if="{{imagePath}}" class="card image-card"><image class="capture-image" src="{{imagePath}}" mode="aspectFit"/><view class="actions"><button disabled="{{busy || recording}}" bindtap="onEditPhoto">编辑 / 裁剪</button><button class="primary" disabled="{{busy || recording}}" bindtap="onRecognize">识别图片</button></view></view>
  <view wx:if="{{preferred === 'voice'}}" class="voice-language"><text>语音语言</text><button class="{{language === 'en' ? 'active' : ''}}" data-language="en" disabled="{{busy || recording}}" bindtap="onLanguage">英语</button><button class="{{language === 'zh' ? 'active' : ''}}" data-language="zh" disabled="{{busy || recording}}" bindtap="onLanguage">中文</button></view>
  <view wx:if="{{message}}" class="info">{{message}}</view><view wx:if="{{error}}" class="info">{{error}}</view>
  <view class="section-head"><text class="section-title">识别结果</text><button class="text-button" bindtap="onCopy">复制</button></view><textarea class="field capture-text" value="{{text}}" bindinput="onInput" maxlength="10000" placeholder="识别文字会显示在这里，也可以直接粘贴。" placeholder-class="muted"/><view class="actions"><button class="primary" bindtap="onLookup">查词</button><button bindtap="onTranslate">全文翻译</button></view><view class="chips"><button wx:for="{{tokens}}" wx:key="*this" class="chip" data-word="{{item}}" bindtap="onWord">{{item}}</button></view>
  <view class="footer">选定的图片或录音会发送到你配置的服务。核对文字后，再查词或翻译。</view>
</view>
