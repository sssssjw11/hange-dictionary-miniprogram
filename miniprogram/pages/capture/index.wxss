.capture-choices{display:flex;gap:19rpx;margin:32rpx 0}.page button.capture-choice{display:flex;flex:1;flex-direction:column;align-items:center;gap:10rpx;min-width:0;width:0;padding:28rpx 10rpx;border-radius:22rpx;background:var(--paper);border-color:var(--line)}.capture-choice image{width:52rpx;height:52rpx;margin-bottom:4rpx}.capture-choice>text:nth-child(2){font-size:28rpx;color:var(--ink)}.capture-choice>text:last-child{font-size:21rpx;color:var(--muted)}.page button.capture-choice.active{background:var(--soft);border-color:#bfdaf0}.voice-language{display:flex;align-items:center;gap:16rpx;margin:20rpx 0;font-size:24rpx;color:var(--muted)}.voice-language button{padding:9rpx 25rpx;border-radius:26rpx;font-size:24rpx;color:var(--muted);background:var(--paper)}.voice-language button.active{color:var(--blue-strong);background:var(--soft);border-color:#bfdaf0}.capture-text{min-height:240rpx;height:280rpx;line-height:1.8}.image-card{padding:18rpx;margin:22rpx 0}.capture-image{width:100%;height:400rpx;background:var(--bg);border-radius:12rpx}.image-card .actions{margin-bottom:0}.dark .capture-choice.active,.dark .voice-language button.active{border-color:#426481}@media(min-width:700px){.capture-choice>text:nth-child(2){font-size:17px}.capture-choice>text:last-child{font-size:13px}.voice-language,.voice-language button{font-size:15px}.capture-text{min-height:150px;height:180px}}
