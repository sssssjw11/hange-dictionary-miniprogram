<view class="page {{theme}}"><view class="title">用法与知识</view><view wx:if="{{selected}}" class="card topic"><view class="row"><text class="word">{{selected.word}}</text><button class="text-button" bindtap="onClose">返回列表</button></view><view class="section-title">{{selected.title}}</view><text class="explanation" selectable="true">{{selected.explanation}}</text><view wx:for="{{selected.patterns}}" wx:key="*this" class="pattern">{{item}}</view><view wx:for="{{selected.examples}}" wx:key="index" class="info"><text>{{item[0]}}</text><text class="meaning">{{item[1]}}</text></view><view wx:if="{{selected.note}}" class="info">{{selected.note}}</view><button class="primary" bindtap="onLookup">查完整词条</button></view><view wx:else><input class="field" value="{{query}}" bindinput="onInput" placeholder="搜索语法概念、单词或用法"/><view class="card topics"><button wx:for="{{rows}}" wx:key="word" class="word-row" data-word="{{item.word}}" bindtap="onSelect"><text class="word">{{item.word}}</text><text class="meaning">{{item.title}}</text></button></view></view><view class="footer">本页为原创学习说明，例句也为原创。与牛津正文、WordNet 英语分义分别标注来源。</view></view>
