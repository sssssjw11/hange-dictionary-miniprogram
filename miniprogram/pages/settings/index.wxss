.segmented{display:flex;border:1rpx solid var(--line);border-radius:18rpx;padding:6rpx;background:var(--soft);gap:6rpx}.segmented button{flex:1;padding:14rpx 4rpx;font-size:26rpx;background:none;border:0;color:var(--muted)}.segmented .chosen{color:var(--blue);background:var(--paper)}.address{margin:24rpx 0 16rpx;font-size:25rpx}.about{padding:28rpx;font-size:24rpx;color:var(--muted)}.about>view{margin:0 0 20rpx}.about>view:last-child{margin-bottom:0}.about .section-title{color:var(--ink)}
.service-list{margin-top:24rpx;padding:0 26rpx}.service-row{padding:20rpx 0}.service-row+.service-row{border-top:1rpx solid var(--line)}.available{color:#4a9a80}.about .text-button{display:block;margin-bottom:22rpx}
.voice-settings{padding:24rpx}.setting-label{display:block;font-size:24rpx;font-weight:600;color:var(--ink);margin:24rpx 0 14rpx}.setting-label:first-child{margin-top:0}.voice-note{margin-top:12rpx;line-height:1.8;overflow-wrap:anywhere}.page .voice-preview{width:100%;margin:24rpx 0 0;padding:13rpx 20rpx;border:1rpx solid var(--line);border-radius:14rpx;background:var(--soft);color:var(--blue-strong);font-size:25rpx}.voice-preview-status{margin-top:14rpx;line-height:1.8;overflow-wrap:anywhere}
