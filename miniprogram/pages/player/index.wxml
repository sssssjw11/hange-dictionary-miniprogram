<view class="page {{theme}}">
 <view class="title">单词播放</view><view class="subtitle">{{name}} · {{total ? index + 1 : 0}} / {{total}}</view>
 <view class="card play-card"><view class="play-word">{{word || '先准备一个词表'}}</view><text class="muted">{{phonetic}}</text><view wx:if="{{showMeaning}}" class="play-meaning">{{meaning}}</view><view wx:if="{{loading}}" class="small muted">正在查词…</view><button wx:if="{{word}}" class="text-button" bindtap="onDetail">查看完整词条</button></view>
 <view wx:if="{{error}}" class="info">{{error}}</view><view wx:if="{{message}}" class="small muted">{{message}}</view><view wx:if="{{voiceStatus}}" class="small muted">{{voiceStatus}}</view>
 <view class="actions"><button disabled="{{!total}}" bindtap="onPrev">上一词</button><button wx:if="{{playing}}" class="primary" bindtap="onPause">暂停</button><button wx:else class="primary" disabled="{{!total || loading}}" bindtap="onPlay">开始播放</button><button disabled="{{!total}}" bindtap="onNext">下一词</button></view>
 <view class="chips"><button class="chip" data-variant="UK" bindtap="onVariant">{{variant === 'UK' ? '✓ ' : ''}}英式</button><button class="chip" data-variant="US" bindtap="onVariant">{{variant === 'US' ? '✓ ' : ''}}美式</button><button wx:for="{{[2,3,5,8,10]}}" wx:key="*this" class="chip" data-seconds="{{item}}" bindtap="onInterval">{{interval === item ? '✓ ' : ''}}间隔 {{item}}s</button></view>
 <view class="card play-settings"><view class="row"><text>显示释义</text><switch checked="{{showMeaning}}" bindchange="onShowMeaning" color="{{accent}}"/></view><view class="row"><text>朗读释义</text><switch checked="{{readMeaning}}" bindchange="onReadMeaning" color="{{accent}}"/></view><view class="row"><text>循环播放</text><switch checked="{{loop}}" bindchange="onLoop" color="{{accent}}"/></view></view>
 <view class="footer">连接本地朗读服务后播放，按实际音色朗读。当前词和设置保存在本机；切换页面或进入后台会暂停。播放不计作已完成复习。</view>
</view>
