<view class="page tab-page profile-page {{theme}}">
  <view class="profile-heading"><view><view class="title">我的词典</view><text class="subtitle">每一点积累，都留在这里。</text></view><view class="local-badge">本机学习</view></view>
  <view class="profile-stats"><view><text>{{favorites}}</text><text>收藏单词</text></view><view><text>{{notes}}</text><text>单词笔记</text></view><view><text>{{learned}}</text><text>已学单词</text></view></view>
  <button class="dictionary-banner" data-path="/pages/dictionaries/index" bindtap="onMenu"><view class="dictionary-emblem"><image src="/assets/study-on.png"/></view><view class="dictionary-copy"><text>牛津高阶英汉双解</text><text>{{offline ? '第10版 · '+definitions+' 条正文' : '导入第10版，开启完整离线查词'}}</text></view><view class="dictionary-tag">{{offline ? '已就绪' : '去导入'}}</view><text class="banner-chevron">›</text></button>
  <view class="service-status"><view class="service-copy"><view class="service-dot"></view><text>{{service}}</text></view><button bindtap="onCheck">检查</button></view>
  <view class="profile-menu card"><button wx:for="{{menus}}" wx:key="path" class="menu-row" data-path="{{item.path}}" bindtap="onMenu"><view class="menu-icon"><image src="/assets/{{item.icon}}-on.png"/></view><view class="menu-copy"><text class="menu-title">{{item.title}}</text><text class="menu-caption">{{item.caption}}</text></view><image class="menu-chevron" src="/assets/chevron.png"/></button></view>
  <view class="profile-signature">涵词典</view>
</view>
