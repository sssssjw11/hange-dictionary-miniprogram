.profile-heading{display:flex;justify-content:space-between;align-items:center;gap:20rpx;margin:8rpx 0 0}.profile-heading .subtitle{font-size:23rpx}.local-badge{font-size:21rpx;color:#80a2b9;border:1rpx solid #dceaf5;border-radius:26rpx;padding:8rpx 16rpx;flex:none}.profile-stats{display:flex;justify-content:space-around;margin:35rpx 0 34rpx;padding:10rpx 0}.profile-stats>view{display:flex;flex:1;flex-direction:column;align-items:center;gap:6rpx}.profile-stats>view+view{border-left:1rpx solid var(--line)}.profile-stats>view>text:first-child{font-size:45rpx;font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-weight:500;line-height:1.3;color:var(--ink)}.profile-stats>view>text:last-child{font-size:23rpx;color:var(--muted)}
.page button.dictionary-banner{display:flex;align-items:center;gap:18rpx;width:100%;padding:26rpx 22rpx;border:1rpx solid #dbeafa;border-radius:21rpx;background:linear-gradient(120deg,#eaf5ff,#f4faff);text-align:left}.dictionary-emblem{display:flex;justify-content:center;align-items:center;width:73rpx;height:73rpx;border-radius:18rpx;background:#fff9;flex:none}.dictionary-emblem image{width:47rpx;height:47rpx}.dictionary-copy{display:flex;flex-direction:column;gap:7rpx;flex:1;min-width:0}.dictionary-copy>text:first-child{font-size:29rpx;color:#3c6e95;font-weight:500}.dictionary-copy>text:last-child{font-size:21rpx;color:#89a3b8}.dictionary-tag{font-size:19rpx;color:#6d99b8;padding:5rpx 10rpx;border:1rpx solid #c6dfef;border-radius:8rpx;flex:none}.banner-chevron{font-size:33rpx;color:#8db3cc;flex:none}
.service-status{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:20rpx 4rpx 29rpx}.service-copy{display:flex;align-items:flex-start;gap:9rpx;min-width:0}.service-copy>text{font-size:21rpx;color:#9ba7b4;overflow-wrap:anywhere}.service-dot{width:6rpx;height:6rpx;border-radius:50%;background:#a2bdcd;margin-top:13rpx;flex:none}.service-status button{border:0;background:none;padding:2rpx;color:var(--blue-strong);font-size:22rpx;flex:none}
.page button.menu-row{display:flex;align-items:center;gap:22rpx;width:100%;padding:23rpx 23rpx;border:0;border-radius:0;text-align:left;background:var(--paper)}.menu-row+.menu-row{border-top:1rpx solid var(--line)}.menu-icon{display:flex;justify-content:center;align-items:center;width:62rpx;height:62rpx;border-radius:16rpx;background:var(--soft);flex:none}.menu-icon image{width:34rpx;height:34rpx;opacity:.88}.menu-copy{flex:1;min-width:0;overflow-wrap:anywhere}.menu-title{display:block;font-size:28rpx;font-weight:400;line-height:1.5}.menu-caption{display:block;font-size:21rpx;color:var(--muted);margin-top:5rpx;line-height:1.55}.menu-chevron{width:23rpx;height:23rpx;opacity:.5;flex:none}.profile-signature{text-align:center;font-size:23rpx;letter-spacing:3rpx;color:#bec7d0;margin-top:40rpx}
.dark .local-badge{border-color:#34475a;color:#8faec4}.dark .dictionary-banner{background:linear-gradient(120deg,#1d3a54,#1e2e40);border-color:#2e4c65}.dark .dictionary-emblem{background:#284761}.dark .dictionary-copy>text:first-child{color:#bfdcf2}.dark .dictionary-copy>text:last-child{color:#87a9c2}.dark .dictionary-tag{border-color:#3d617d;color:#97bfdc}.dark .profile-signature{color:#51657a}
@media(min-width:700px){.profile-heading .subtitle{font-size:14px}.local-badge{font-size:13px}.profile-stats>view>text:first-child{font-size:30px}.profile-stats>view>text:last-child{font-size:14px}.dictionary-copy>text:first-child{font-size:17px}.dictionary-copy>text:last-child,.dictionary-tag{font-size:12px}.service-copy>text,.service-status button{font-size:13px}.menu-title{font-size:17px}.menu-caption{font-size:13px}.profile-signature{font-size:14px}}
