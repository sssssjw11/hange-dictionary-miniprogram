.profile-stats{display:flex;justify-content:space-around;margin:30rpx 0;padding:28rpx 8rpx}.profile-stats>view{display:flex;flex-direction:column;align-items:center;color:var(--muted);font-size:23rpx}.profile-stats>view>text:first-child{font-size:43rpx;font-weight:700;color:var(--ink)}.menu-title{font-size:31rpx;font-weight:600}.info .row{margin-top:12rpx;align-items:flex-start}.info .row .small{flex:1;min-width:0}.info .text-button{white-space:nowrap}
