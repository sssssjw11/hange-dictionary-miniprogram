<view class="page {{theme}}">
  <view wx:if="{{loading}}" class="loading">正在查词…</view>
  <view wx:elif="{{entry}}">
    <text class="eyebrow">{{entry.sourceLabel}}</text><text wx:if="{{entry.matchedFrom}}" class="small muted">由 {{entry.matchedFrom}} 匹配到</text>
    <view class="entry-top"><text class="headword">{{entry.word}}</text><button class="favorite {{favorite ? 'selected' : ''}}" bindtap="onFavorite">{{favorite ? '★ 已收藏' : '☆ 收藏'}}</button></view>
    <view wx:if="{{entry.phonetic}}" class="phonetic">/{{entry.phonetic}}/</view>
    <view class="entry-actions"><button bindtap="onCopy">复制单词</button><text class="small muted">释义按来源呈现</text></view>
    <view wx:if="{{entry.zh}}" class="card base-meaning"><text class="eyebrow">中文简释 · ECDICT</text><text selectable="true" class="meaning-text">{{entry.zh}}</text></view>
    <view wx:if="{{entry.en}}" class="card base-meaning english-base"><text class="eyebrow">英文简释 · ECDICT</text><text selectable="true" class="meaning-text">{{entry.en}}</text></view>
    <view class="chips forms"><button wx:for="{{entry.forms}}" wx:key="index" class="chip" data-word="{{item.word}}" bindtap="onWord">{{item.label}} {{item.word}}</button></view>
    <view id="content-start" class="source-tabs"><button wx:if="{{entry.hasOxford}}" class="{{source === 'oxford' ? 'active' : ''}}" data-source="oxford" bindtap="onSource">牛津十版</button><button wx:if="{{entry.hasTeaching}}" class="{{source === 'teaching' ? 'active' : ''}}" data-source="teaching" bindtap="onSource">用法讲清楚</button><button wx:if="{{entry.hasSenses}}" class="{{source === 'wordnet' ? 'active' : ''}}" data-source="wordnet" bindtap="onSource">英语分义</button></view>
    <view wx:if="{{source === 'oxford'}}" class="card reader-card" style="font-size:{{fontSize}}px"><view class="reader-heading"><text class="eyebrow">OXFORD · 第10版</text><text class="section-title">牛津高阶英汉双解</text><text class="small muted">全部正文分段呈现。原词库未附音频和插图。</text></view><rich-text wx:for="{{oxfordBlocks}}" wx:key="id" class="rich-body" nodes="{{item.nodes}}" user-select="{{true}}" space="nbsp"/><view wx:if="{{totalPages > 1}}" class="pagination"><button disabled="{{page === 0}}" bindtap="onPrev">上一页</button><text>{{page + 1}} / {{totalPages}} 页</text><button disabled="{{page + 1 === totalPages}}" bindtap="onNext">下一页</button></view></view>
    <view wx:elif="{{source === 'teaching' && teaching}}" class="card reader-card usage" style="font-size:{{fontSize}}px"><text class="eyebrow">原创学习说明</text><view class="usage-title">{{teaching.title}}</view><text selectable="true">{{teaching.explanation}}</text><view wx:if="{{teaching.patterns.length}}" class="section-head"><text class="section-title">常用搭配</text></view><view wx:for="{{teaching.patterns}}" wx:key="*this" class="pattern">{{item}}</view><view class="section-head"><text class="section-title">例句拆解</text></view><view wx:for="{{teaching.examples}}" wx:key="index" class="example"><text selectable="true">{{item[0]}}</text><text selectable="true" class="example-zh">{{item[1]}}</text></view><view wx:if="{{teaching.note}}" class="info">{{teaching.note}}</view></view>
    <view wx:elif="{{source === 'wordnet' && entry.hasSenses}}" class="card reader-card" style="font-size:{{fontSize}}px"><text class="eyebrow">WORDNET 3.1</text><view class="small muted">不同义项与例句；不与中文简释逐条对应。</view><view wx:for="{{senses}}" wx:key="index" class="sense"><text class="pos">{{item.posLabel}}</text><text selectable="true">{{item.definition}}</text><text wx:for="{{item.examples}}" wx:for-item="example" wx:key="*this" class="example-zh" selectable="true">{{example}}</text><view class="chips"><button wx:for="{{item.synonyms}}" wx:for-item="synonym" wx:key="*this" class="chip" data-word="{{synonym}}" bindtap="onWord">{{synonym}}</button></view><view wx:if="{{item.antonyms.length}}" class="small muted">反义表达</view><view class="chips"><button wx:for="{{item.antonyms}}" wx:for-item="antonym" wx:key="*this" class="chip" data-word="{{antonym}}" bindtap="onWord">{{antonym}}</button></view></view><view wx:if="{{totalPages > 1}}" class="pagination"><button disabled="{{page === 0}}" bindtap="onPrev">上一页</button><text>{{page + 1}} / {{totalPages}} 页</text><button disabled="{{page + 1 === totalPages}}" bindtap="onNext">下一页</button></view></view>
    <view wx:if="{{related.length}}"><view class="section-head"><text class="section-title">关联查词</text></view><view class="chips"><button wx:for="{{related}}" wx:key="*this" class="chip" data-word="{{item}}" bindtap="onWord">{{item}}</button></view></view>
    <view class="card note-card"><view class="section-head"><text class="section-title">我的笔记</text><text class="small muted">仅保存在本机</text></view><textarea class="note-input" value="{{note}}" maxlength="4000" auto-height="{{true}}" placeholder="记下自己的例句、搭配或易混点…" placeholder-class="muted" bindinput="onNote"/><view class="row"><text class="small muted">{{noteStatus}}</text><button class="primary" bindtap="onSaveNote">保存笔记</button></view></view>
    <view class="footer">来源：ECDICT（MIT）· WordNet 3.1（Princeton University）；牛津内容仅来自自行配置的词库。学习说明及其双语例句为原创。</view>
  </view>
  <view wx:else><view class="page-heading"><text class="eyebrow">{{matchQuery}}</text><view class="title">{{matches.length ? '找到这些词条' : '暂时无法查到'}}</view></view><view wx:if="{{partial}}" class="info">当前结果来自内置离线词条；连接词库服务可反查更完整的内容。</view><view wx:if="{{error}}" class="card error-card"><text class="muted">{{error}}</text><button class="primary" bindtap="onRetry">重新查询</button></view><view wx:if="{{matches.length}}" class="card"><button wx:for="{{matches}}" wx:key="word" class="word-row" data-word="{{item.word}}" bindtap="onWord"><text class="word">{{item.word}}</text><text class="meaning">{{item.meaning}}</text></button></view></view>
</view>
