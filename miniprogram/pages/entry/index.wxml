<view class="page {{theme}}">
  <view wx:if="{{loading}}" class="loading">正在查词…</view>
  <view wx:elif="{{entry}}">
    <text class="eyebrow">{{entry.sourceLabel}}</text><text wx:if="{{entry.matchedFrom}}" class="small muted">由 {{entry.matchedFrom}} 匹配到</text>
    <view class="entry-top"><text class="headword">{{entry.word}}</text><button class="favorite {{favorite ? 'selected' : ''}}" bindtap="onFavorite">{{favorite ? '★ 已收藏' : '☆ 收藏'}}</button></view>
    <view wx:if="{{entry.learningTags.length}}" class="learning-tags"><text wx:for="{{entry.learningTags}}" wx:key="*this" class="learning-tag">{{item}}</text></view>
    <view wx:if="{{entry.phonetics.uk || entry.phonetics.us}}" class="phonetic"><text wx:if="{{entry.phonetics.uk}}">英 {{entry.phonetics.uk}}　</text><text wx:if="{{entry.phonetics.us}}">美 {{entry.phonetics.us}}</text></view><view wx:elif="{{entry.phonetic}}" class="phonetic">/{{entry.phonetic}}/</view>
    <view class="entry-actions chips"><button data-variant="UK" bindtap="onSpeak">{{speakingVariant === 'UK' ? '停止英音' : '英式发音'}}</button><button data-variant="US" bindtap="onSpeak">{{speakingVariant === 'US' ? '停止美音' : '美式发音'}}</button><button bindtap="onCopy">复制</button><button bindtap="onAI">AI 讲解</button><button bindtap="onKnown">标为掌握</button><button bindtap="onGroups">生词本分组</button><button wx:if="{{entry.hasContents}}" disabled="{{contentsLoading || wordListsLoading}}" bindtap="onContents">{{contentsLoading ? '正在读取…' : '牛津目录'}}</button><button wx:if="{{entry.hasOxford}}" disabled="{{wordListsLoading || contentsLoading}}" bindtap="onWordLists">{{wordListsLoading ? '读取词表…' : wordListsOpen ? '收起词表' : '所属词表'}}</button><button wx:if="{{entry.hasOxford}}" bindtap="onDictionaryMedia">录音与插图</button></view>
    <view wx:if="{{voiceStatus}}" class="small muted">{{voiceStatus}}</view>
    <view wx:if="{{bookNames}}" class="small muted">生词本：{{bookNames}}</view><view class="chips forms"><button wx:for="{{entry.forms}}" wx:key="index" class="chip" data-word="{{item.word}}" bindtap="onWord">{{item.label}} {{item.word}}</button></view>
    <view class="dictionary-tools"><text>{{supplementNote}}</text><button class="text-button" disabled="{{supplementLoading}}" bindtap="onMoreDictionaries">{{supplementLoading ? '正在读取…' : supplementState ? '更新补充词典' : '更多词典'}}</button></view>
    <view wx:if="{{supplementError}}" class="info supplement-error">{{supplementError}}</view>
    <view wx:if="{{wordListsOpen}}" id="entry-wordlists" class="card wordlists-card"><view class="section-head"><text class="section-title">词表与主题</text><button class="text-button" bindtap="onAllWordLists">全部词表 ›</button></view><view wx:if="{{wordListsError}}" class="info">{{wordListsError}}</view><view wx:elif="{{!wordListTotal}}" class="small muted">此词没有附带词表链接，可浏览全部词表。</view><button wx:for="{{wordListRows}}" wx:key="id" class="entry-wordlist-row" data-index="{{item.index}}" bindtap="onWordListLink"><text>{{item.name}}</text><text class="entry-wordlist-arrow">›</text></button><view wx:if="{{wordListPages > 1}}" class="pagination"><button disabled="{{wordListPage === 0}}" bindtap="onWordListsPrev">上一组</button><text>{{wordListPage+1}} / {{wordListPages}}</text><button disabled="{{wordListPage+1 === wordListPages}}" bindtap="onWordListsNext">下一组</button></view></view>
    <view wx:if="{{contentsOpen}}" id="entry-contents" class="card contents-card"><view class="section-head"><text class="section-title">牛津释义目录</text><button class="text-button" bindtap="onContents">收起</button></view><view wx:if="{{localJumpRows.length}}" class="chips"><button wx:for="{{localJumpRows}}" wx:key="index" data-index="{{item.index}}" bindtap="onLocalJump">{{item.displayLabel || item.label}}</button></view><button wx:for="{{contentsRows}}" wx:key="key" class="contents-row" data-index="{{item.index}}" bindtap="onContentsItem"><text class="contents-kind">{{item.kind}}</text><view class="contents-copy"><text class="contents-title">{{item.label}}</text><text wx:if="{{item.learningLabel}}" class="contents-learning">{{item.learningLabel}}</text></view></button><view wx:if="{{contentsPages > 1}}" class="pagination contents-pagination"><button disabled="{{contentsPage === 0}}" bindtap="onContentsPrev">上一组</button><text>{{contentsPage+1}} / {{contentsPages}}</text><button disabled="{{contentsPage+1 === contentsPages}}" bindtap="onContentsNext">下一组</button></view></view>
    <view id="content-start" class="source-tabs"><button wx:if="{{entry.hasOxford}}" class="{{source === 'oxford' ? 'active' : ''}}" data-source="oxford" bindtap="onSource">牛津十版</button><button wx:if="{{entry.hasExamples}}" class="{{source === 'examples' ? 'active' : ''}}" data-source="examples" bindtap="onSource">双语例句</button><button wx:if="{{entry.hasTeaching}}" class="{{source === 'teaching' ? 'active' : ''}}" data-source="teaching" bindtap="onSource">用法讲清楚</button><button wx:if="{{entry.hasSenses}}" class="{{source === 'wordnet' ? 'active' : ''}}" data-source="wordnet" bindtap="onSource">英语分义</button><button wx:if="{{entry.hasBase}}" class="{{source === 'base' ? 'active' : ''}}" data-source="base" bindtap="onSource">开源简释</button></view>
    <view wx:if="{{focusError}}" class="info">{{focusError}}</view><view wx:if="{{focusLabel && source === 'oxford'}}" class="info focus-info"><text>定位：{{focusLabel}}</text><button class="text-button" bindtap="onClearFocus">回到全文</button></view>
    <view wx:if="{{source === 'oxford' || source === 'examples'}}" class="pick-entry"><text>遇到生词或短语？</text><button class="text-button" bindtap="onPickText">点词查释义 <text>›</text></button></view>
    <view wx:if="{{source === 'oxford'}}" class="card reader-card" style="font-size:{{fontSize}}px"><view class="reader-heading"><text class="reader-book">牛津高阶英汉双解</text><text class="reader-edition">第10版{{totalPages > 1 ? ' · '+(page+1)+' / '+totalPages : ''}}</text></view><view wx:for="{{oxfordBlocks}}" wx:key="id" id="oxford-{{item.id}}" class="oxford-block"><rich-text class="rich-body" nodes="{{item.nodes}}" user-select="{{true}}"/></view><view wx:if="{{totalPages > 1}}" class="pagination"><button disabled="{{page === 0}}" bindtap="onPrev">上一页</button><text>{{page+1}} / {{totalPages}} 页</text><button disabled="{{page+1 === totalPages}}" bindtap="onNext">下一页</button></view></view>
    <view wx:elif="{{source === 'examples'}}" class="card reader-card" style="font-size:{{fontSize}}px"><text class="eyebrow">牛津双语例句 · 共 {{totalItems}} 条</text><view wx:for="{{examples}}" wx:key="index" class="example"><text selectable="true">{{item.en}}</text><text wx:if="{{item.zh}}" class="example-zh" selectable="true">{{item.zh}}</text><view class="example-actions"><button class="text-button" data-index="{{index}}" bindtap="onSpeakExample">{{speakingExample === page * 8 + index ? '停止朗读' : '朗读例句'}}</button><button class="text-button" data-index="{{index}}" bindtap="onSaveExample">收藏此例句</button></view><view wx:if="{{exampleStatusIndex === page * 8 + index && exampleStatus}}" class="example-status">{{exampleStatus}}</view></view><view wx:if="{{totalPages > 1}}" class="pagination"><button disabled="{{page === 0}}" bindtap="onPrev">上一页</button><text>{{page+1}} / {{totalPages}}</text><button disabled="{{page+1 === totalPages}}" bindtap="onNext">下一页</button></view></view>
    <view wx:elif="{{source === 'teaching' && teaching}}" class="card reader-card usage" style="font-size:{{fontSize}}px"><text class="eyebrow">原创学习说明</text><view class="usage-title">{{teaching.title}}</view><text selectable="true">{{teaching.explanation}}</text><view wx:if="{{teaching.patterns.length}}" class="section-head"><text class="section-title">常用搭配</text></view><view wx:for="{{teaching.patterns}}" wx:key="*this" class="pattern">{{item}}</view><view class="section-head"><text class="section-title">例句拆解</text></view><view wx:for="{{teaching.examples}}" wx:key="index" class="example"><text selectable="true">{{item[0]}}</text><text selectable="true" class="example-zh">{{item[1]}}</text></view><view wx:if="{{teaching.note}}" class="info">{{teaching.note}}</view></view>
    <view wx:elif="{{source === 'wordnet' && entry.hasSenses}}" class="card reader-card" style="font-size:{{fontSize}}px"><text class="eyebrow">WORDNET 3.1</text><view class="small muted">不同义项与例句；不与中文简释逐条对应。</view><view wx:for="{{senses}}" wx:key="index" class="sense"><text class="pos">{{item.posLabel}}</text><text selectable="true">{{item.definition}}</text><text wx:for="{{item.examples}}" wx:for-item="example" wx:key="*this" class="example-zh" selectable="true">{{example}}</text><view class="chips"><button wx:for="{{item.synonyms}}" wx:for-item="synonym" wx:key="*this" class="chip" data-word="{{synonym}}" bindtap="onWord">{{synonym}}</button></view><view wx:if="{{item.antonyms.length}}" class="small muted">反义表达</view><view class="chips"><button wx:for="{{item.antonyms}}" wx:for-item="antonym" wx:key="*this" class="chip" data-word="{{antonym}}" bindtap="onWord">{{antonym}}</button></view></view><view wx:if="{{totalPages > 1}}" class="pagination"><button disabled="{{page === 0}}" bindtap="onPrev">上一页</button><text>{{page+1}} / {{totalPages}}</text><button disabled="{{page+1 === totalPages}}" bindtap="onNext">下一页</button></view></view>
    <view wx:elif="{{source === 'base'}}"><view wx:if="{{entry.zh}}" class="card base-meaning"><text class="eyebrow">中文简释 · ECDICT</text><text selectable="true" class="meaning-text">{{entry.zh}}</text></view><view wx:if="{{entry.en}}" class="card base-meaning english-base"><text class="eyebrow">英文简释 · ECDICT</text><text selectable="true" class="meaning-text">{{entry.en}}</text></view></view>
    <view wx:if="{{relatedTotal}}"><view id="related-start" class="section-head"><text class="section-title">关联查词</text><text class="small muted">共 {{relatedTotal}} 个目标</text></view><view class="chips"><button wx:for="{{referenceRows}}" wx:key="index" class="chip" data-index="{{item.index}}" bindtap="onReference">{{item.label}}</button></view><view wx:if="{{relatedPages > 1}}" class="pagination related-pagination"><button disabled="{{relatedPage === 0}}" bindtap="onRelatedPrev">上一组</button><text>{{relatedPage+1}} / {{relatedPages}}</text><button disabled="{{relatedPage+1 === relatedPages}}" bindtap="onRelatedNext">下一组</button></view></view>
    <view class="card note-card"><view class="section-head"><text class="section-title">我的笔记</text><text class="small muted">仅保存在本机</text></view><textarea class="note-input" value="{{note}}" maxlength="4000" auto-height="{{true}}" placeholder="记下自己的例句、搭配或易混点…" placeholder-class="muted" bindinput="onNote"/><view class="row"><text id="note-status" class="small muted">{{noteStatus}}</text><button class="primary" bindtap="onSaveNote">保存笔记</button></view></view>
    <view class="footer">牛津内容来自自行导入的词库；ECDICT、WordNet 和原创说明分别标明来源。发音优先匹配原版词形及口音，未提供时使用本机服务端音色，并显示实际音源。</view>
  </view>
  <view wx:else>
    <view id="matches-start" class="page-heading"><text class="eyebrow">{{matchQuery}}</text><view class="title">{{matches.length ? (resultKind === 'missing' ? '可能想查' : '找到这些词条') : '暂时无法查到'}}</view><view wx:if="{{matches.length && resultKind !== 'missing'}}" class="match-meta"><text>第 {{matchPage+1}} 页 · {{matches.length}} 个词条</text><text wx:if="{{matchLoading}}">正在翻页…</text><text wx:elif="{{matchNextCursor !== null}}">还有更多结果</text><text wx:else>{{matchPage > 0 ? '已到最后一页' : '已显示全部'}}</text></view></view>
    <view wx:if="{{partial}}" class="info">当前结果来自内置词条；导入离线词库可查询完整牛津。</view>
    <view wx:if="{{error}}" class="card error-card"><text class="muted">{{error}}</text><button wx:if="{{!matches.length || resultKind !== 'missing'}}" class="primary" bindtap="onRetry">重新查询</button></view>
    <view wx:if="{{matches.length}}" class="card"><button wx:for="{{matches}}" wx:key="word" class="word-row" disabled="{{matchLoading}}" data-word="{{item.word}}" bindtap="onWord"><text class="word">{{item.word}}</text><text class="meaning">{{item.meaning}}</text></button></view>
    <view wx:if="{{matches.length && (matchPage > 0 || matchNextCursor !== null)}}" class="pagination match-pagination"><button disabled="{{matchLoading || matchPage === 0}}" bindtap="onMatchPrev">上一页</button><text>{{matchLoading ? '正在翻页…' : '第 '+(matchPage+1)+' 页'}}</text><button disabled="{{matchLoading || matchNextCursor === null}}" bindtap="onMatchNext">下一页</button></view>
    <view wx:if="{{matchError}}" class="info match-error"><text>{{matchError}}</text><button class="text-button" disabled="{{matchLoading}}" bindtap="onMatchRetry">重试翻页</button></view>
  </view>
 <view wx:if="{{pickOpen}}" class="pick-mask" bindtap="closePickText"></view>
 <view wx:if="{{pickOpen}}" class="pick-sheet">
  <view class="pick-heading"><view><text class="pick-title">点词查释义</text><text class="pick-caption">点击单词或汉字，选择词句可查询短语</text></view><button class="text-button" bindtap="closePickText">关闭</button></view>
  <view class="pick-controls"><button class="{{pickSelecting ? 'chosen' : ''}}" bindtap="onPickMode">{{pickSelecting ? '结束选段' : '选择词句'}}</button><text>{{pickSelecting ? '依次点击起点和终点' : '点击文字查看释义'}}</text></view>
  <view wx:if="{{pickSelectionLength}}" class="pick-selection"><text>{{pickSelection}}</text><view class="pick-selection-actions"><text>{{pickSelectionLength}} 字{{pickSelectionLength > 256 ? ' · 最多 256 字' : ''}}</text><button class="text-button" disabled="{{pickSelectionLength > 256}}" bindtap="onPickSelected">查询所选</button></view></view>
  <view wx:if="{{pickWord}}" class="pick-result"><view class="row"><text class="pick-result-word">{{pickWord}}</text><text wx:if="{{pickLooking}}" class="small muted">查询中…</text></view><view class="pick-meaning">{{pickMeaning}}</view><view class="pick-result-actions"><button class="text-button" bindtap="onPickDetail">完整释义 ›</button><button class="text-button" disabled="{{pickLooking || !pickCanFavorite}}" bindtap="onPickFavorite">加入生词本</button></view></view>
  <scroll-view class="pick-body" scroll-y="{{true}}" scroll-into-view="pick-start-{{pickPage}}"><view id="pick-start-{{pickPage}}" class="pick-text" style="font-size:{{fontSize}}px"><text wx:for="{{pickTokens}}" wx:key="id" class="{{item.word ? 'pick-word' : ''}} {{item.selected ? 'pick-selected' : ''}}" data-start="{{item.start}}" data-end="{{item.end}}" data-word="{{item.word}}" bindtap="onPickToken">{{item.text}}</text></view></scroll-view>
  <view wx:if="{{pickPages > 1}}" class="pick-pagination"><button disabled="{{pickPage === 0}}" bindtap="onPickPrev">上一段</button><text>{{pickPage+1}} / {{pickPages}}</text><button disabled="{{pickPage+1 === pickPages}}" bindtap="onPickNext">下一段</button></view>
 </view>
 <group-picker visible="{{groupPicker}}" word="{{entry.word}}" meaning="{{groupingMeaning}}" theme="{{theme}}" bindsave="onGroupSaved" bindclose="onGroupClose"/>
</view>
