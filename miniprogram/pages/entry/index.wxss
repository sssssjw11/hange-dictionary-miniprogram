.entry-top{display:flex;justify-content:space-between;align-items:center;gap:18rpx;margin:8rpx 0}.headword{font-size:62rpx;font-weight:700;line-height:1.3;overflow-wrap:anywhere;word-break:break-word;flex:1;min-width:0;letter-spacing:-1rpx}.favorite{flex:none;padding:9rpx 18rpx;font-size:24rpx;border-radius:36rpx;color:var(--muted)}.favorite.selected{color:var(--blue);border-color:var(--blue);background:var(--soft)}.phonetic{color:var(--muted);font-size:28rpx;margin-top:12rpx}.entry-actions{display:flex;align-items:center;justify-content:space-between;margin:24rpx 0}.entry-actions button{font-size:24rpx;padding:8rpx 20rpx;color:var(--blue)}.base-meaning{padding:24rpx 28rpx}.meaning-text{display:block;white-space:pre-line;margin-top:12rpx;line-height:1.9;font-size:29rpx}.source-tabs{display:flex;gap:12rpx;margin:30rpx 0 24rpx;flex-wrap:wrap}.source-tabs button{font-size:25rpx;padding:10rpx 24rpx;color:var(--muted);border-radius:30rpx;background:transparent}.source-tabs button.active{color:var(--blue);background:var(--soft);border-color:var(--blue)}.reader-card{padding:28rpx 26rpx;overflow-wrap:anywhere}.reader-heading{display:flex;flex-direction:column;gap:10rpx;border-bottom:1rpx solid var(--line);padding-bottom:22rpx;margin-bottom:20rpx}.rich-body{display:block;line-height:1.75;word-break:normal;overflow-wrap:break-word}.usage-title{font-weight:600;font-size:34rpx;margin:20rpx 0 16rpx}.pattern{margin:10rpx 0;font-size:29rpx}.example{margin:16rpx 0;padding:16rpx 20rpx;background:var(--bg);border-radius:12rpx}.example-zh{display:block;opacity:.75;font-size:28rpx;margin-top:7rpx;line-height:1.85}.note-card{padding:28rpx;margin-top:36rpx}.note-card .section-head{margin-top:0}.note-input{width:100%;min-height:200rpx;padding:22rpx;background:var(--bg);color:var(--ink);border:1rpx solid var(--line);border-radius:16rpx;font-size:28rpx;line-height:1.8;margin:18rpx 0 22rpx}.note-card button{font-size:25rpx}.sense{padding:24rpx 0;border-bottom:1rpx solid var(--line)}.pos{display:block;font-size:23rpx;color:var(--blue);font-weight:600;margin-bottom:10rpx}.forms{margin-top:18rpx}

.source-tabs{gap:16rpx;border-bottom:1rpx solid var(--line);margin:26rpx 0 23rpx}.page .source-tabs button{border:0;border-radius:0;border-bottom:4rpx solid transparent;padding:14rpx 6rpx;font-size:24rpx;background:transparent;color:var(--muted)}.page .source-tabs button.active{border-bottom-color:var(--blue);background:transparent;color:var(--blue-strong)}.reader-heading{flex-direction:row;align-items:center;justify-content:space-between;gap:14rpx;padding-bottom:18rpx;margin-bottom:16rpx}.reader-book{font-size:22rpx;color:var(--muted)}.reader-edition{font-size:20rpx;color:#a4afbb;flex:none}.entry-actions{justify-content:flex-start;gap:9rpx}.entry-actions button{margin:4rpx 0;padding:9rpx 16rpx;border-color:var(--line);background:var(--paper);border-radius:22rpx;font-size:22rpx}.reader-card{border-radius:18rpx}.favorite{border-color:var(--line);font-size:22rpx;color:var(--muted)}.phonetic{font-size:25rpx}.note-input{border-color:var(--line);border-radius:15rpx}.note-card{border-radius:19rpx}
@media(min-width:700px){.page .source-tabs button{font-size:14px}.reader-book{font-size:13px}.reader-edition{font-size:12px}.entry-actions button,.favorite{font-size:13px}.phonetic{font-size:15px}}
.match-meta{display:flex;justify-content:space-between;gap:16rpx;flex-wrap:wrap;margin-top:16rpx;font-size:23rpx;color:var(--muted)}.match-pagination{margin:28rpx 0 16rpx}.match-error{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.match-error text{flex:1;min-width:0}.match-error button{flex:none}
.dictionary-tools{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:24rpx 0 0}.dictionary-tools text{font-size:22rpx;color:var(--muted);flex:1;min-width:0}.page .dictionary-tools button{font-size:23rpx;color:var(--blue);padding:10rpx 16rpx;flex:none;border:1rpx solid var(--line);border-radius:22rpx;background:var(--paper)}.supplement-error{font-size:24rpx;margin-top:16rpx}
.contents-card{margin-top:24rpx;padding:24rpx}.contents-card .section-head{margin-top:0}.page .contents-row{display:flex;align-items:flex-start;gap:16rpx;text-align:left;width:100%;border:0;border-bottom:1rpx solid var(--line);border-radius:0;padding:20rpx 0;background:transparent;font-size:26rpx;line-height:1.7}.contents-row text:last-child{flex:1;min-width:0;overflow-wrap:anywhere}.contents-kind{flex:none;color:var(--blue);font-size:22rpx;padding-top:3rpx}.focus-info{display:flex;align-items:center;gap:16rpx}.focus-info text{flex:1;min-width:0;overflow-wrap:anywhere}.focus-info button{flex:none}.oxford-block{min-height:1rpx}
.page-heading .eyebrow{overflow-wrap:anywhere;word-break:break-word}

.learning-tags{display:flex;flex-wrap:wrap;gap:8rpx;margin:14rpx 0;max-width:100%}.learning-tag{padding:4rpx 12rpx;border:1rpx solid var(--line);border-radius:9rpx;background:var(--soft);color:var(--blue-strong);font-size:22rpx;line-height:1.6;overflow-wrap:anywhere}.contents-copy{flex:1;min-width:0}.contents-title{display:block;overflow-wrap:anywhere}.contents-learning{display:block;margin-top:6rpx;color:var(--muted);font-size:21rpx;line-height:1.6;overflow-wrap:anywhere}
.wordlists-card{margin-top:24rpx;padding:24rpx}.wordlists-card .section-head{margin-top:0}.page .entry-wordlist-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;width:100%;padding:20rpx 0;border:0;border-bottom:1rpx solid var(--line);border-radius:0;background:transparent;color:var(--blue-strong);font-size:25rpx;text-align:left;line-height:1.7}.entry-wordlist-row text:first-child{flex:1;min-width:0;overflow-wrap:anywhere}.entry-wordlist-arrow{flex:none;color:var(--muted);font-size:32rpx}
.example-actions{display:flex;align-items:center;gap:32rpx;flex-wrap:wrap;margin-top:14rpx}.example-status{font-size:21rpx;line-height:1.7;color:var(--muted);margin-top:10rpx;overflow-wrap:anywhere}
