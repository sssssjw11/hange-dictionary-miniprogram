<view class="page {{theme}}"><view class="page-heading"><text class="eyebrow">RECENT LOOKUPS</text><view class="title">查词记录</view><view class="subtitle">按最近查询排序，显示最近 100 条。</view></view><view class="section-head"><text class="section-title">最近查询</text><button class="text-button" bindtap="onClear">清空记录</button></view><view class="card"><button wx:for="{{rows}}" wx:key="word" class="word-row" data-word="{{item.word}}" bindtap="onWord"><text class="word">{{item.word}}</text><text class="meaning">{{item.meaning}}</text></button><view wx:if="{{!rows.length}}" class="empty">查过的词会留在这里。</view></view></view>
