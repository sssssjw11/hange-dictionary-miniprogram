page{background:#f4f8fb;color:#193448;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx;line-height:1.65}view,text,input,textarea,button{box-sizing:border-box}button{font:inherit;line-height:1.6;margin:0;padding:14rpx 24rpx;border:1rpx solid var(--line);border-radius:16rpx;background:var(--paper);color:var(--ink)}button::after{border:0}button[disabled]{opacity:.45}.page{--bg:#f4f8fb;--paper:#fff;--ink:#193448;--muted:#788e9f;--blue:#267fbb;--soft:#eaf4fb;--line:#e0eaf1;background:var(--bg);color:var(--ink);min-height:100vh;padding:36rpx 32rpx 64rpx;padding-bottom:calc(64rpx + env(safe-area-inset-bottom))}.page.dark{--bg:#14212b;--paper:#1c2d39;--ink:#e0edf4;--muted:#9aafbd;--blue:#8bc3ee;--soft:#26465b;--line:#2b4353}.eyebrow{display:block;color:var(--blue);font-size:20rpx;letter-spacing:2rpx;font-weight:600}.title{font-size:52rpx;font-weight:700;letter-spacing:-1.4rpx;line-height:1.45;margin:12rpx 0}.subtitle{font-size:25rpx;color:var(--muted)}.muted{color:var(--muted)}.small{font-size:23rpx}.section-head{display:flex;justify-content:space-between;align-items:center;margin:36rpx 0 18rpx}.section-title{font-size:28rpx;font-weight:600}.text-button{font-size:24rpx;color:var(--blue);padding:0;background:none;border:0}.card{background:var(--paper);border:1rpx solid var(--line);border-radius:26rpx;overflow:hidden}.word-row{display:block;text-align:left;width:100%;border-radius:0;border:0;background:var(--paper);padding:26rpx 30rpx}.word-row+.word-row{border-top:1rpx solid var(--line)}.word{display:block;font-weight:600;font-size:34rpx;overflow-wrap:anywhere;word-break:break-word}.meaning{display:block;font-size:25rpx;color:var(--muted);margin-top:6rpx;white-space:pre-line}.note-preview{display:block;font-size:24rpx;color:var(--blue);margin-top:8rpx}.empty{padding:56rpx 24rpx;text-align:center;color:var(--muted);font-size:26rpx}.chips{display:flex;flex-wrap:wrap;margin:0 -6rpx}.chip{padding:8rpx 20rpx;font-size:24rpx;border-radius:50rpx;margin:6rpx;color:var(--blue);max-width:100%;white-space:normal;overflow-wrap:anywhere;word-break:break-word}.primary{color:#fff;background:var(--blue);border-color:var(--blue);font-weight:600}.dark .primary{color:#132c3e}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.actions{display:flex;gap:16rpx;margin:24rpx 0}.actions button{flex:1;font-size:25rpx;min-width:0}.field{background:var(--paper);border:1rpx solid var(--line);border-radius:18rpx;padding:20rpx 24rpx;color:var(--ink);font-size:28rpx;width:100%;min-height:84rpx}.info{border-radius:18rpx;background:var(--soft);color:var(--muted);padding:20rpx 24rpx;font-size:24rpx;margin:24rpx 0}.footer{font-size:21rpx;color:var(--muted);line-height:1.85;margin-top:34rpx}.loading{padding:100rpx 0;text-align:center;color:var(--muted)}.error-card{padding:36rpx}.error-card button{margin-top:24rpx}.error-title{display:block;font-size:34rpx;font-weight:600;margin-bottom:12rpx}.search-icon{height:30rpx;width:30rpx;flex:none;margin-right:20rpx;opacity:.8}.page-heading{padding:12rpx 0 24rpx}.pagination{display:flex;justify-content:space-between;align-items:center;padding:24rpx 0;margin-top:18rpx;gap:12rpx}.pagination button{font-size:24rpx;padding:12rpx 24rpx}.pagination text{font-size:23rpx;color:var(--muted)}
@media(min-width:700px){page{font-size:16px}.page{max-width:900px;margin:0 auto;padding:28px 30px 60px}.title{font-size:32px}.subtitle,.meaning,.small{font-size:14px}.word{font-size:22px}.word-row{padding:18px 22px}.section-title{font-size:18px}.chip,.text-button,.actions button{font-size:14px}.field{font-size:16px;min-height:46px;padding:12px 16px}.eyebrow,.footer{font-size:12px}.row{gap:14px}.headword{font-size:38px!important}.brand{font-size:24px!important}.brand-mark{font-size:16px!important;width:28px!important;line-height:28px!important}.search-input{font-size:17px!important}.source-tabs button{font-size:14px!important}.reader-title{font-size:28px!important}.lookup-sheet{max-width:900px;margin:auto}.metric{font-size:30px!important}}
.title,.subtitle,.info{overflow-wrap:anywhere;word-break:break-word}
