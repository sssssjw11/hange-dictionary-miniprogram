page{background:#f7f9fc;color:#222a35;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.65}
view,text,input,textarea,button{box-sizing:border-box}
button{min-width:0;font:inherit;line-height:1.55;margin:0;padding:17rpx 26rpx;border:1rpx solid var(--line);border-radius:18rpx;background:var(--paper);color:var(--ink)}
.page button{width:auto}button::after{border:0}button[disabled]{opacity:.42}
.page{--bg:#f7f9fc;--paper:#fff;--ink:#222a35;--muted:#929ca9;--blue:#278de0;--blue-strong:#187bc7;--soft:#edf6fe;--line:#eaf0f6;background:var(--bg);color:var(--ink);min-height:100vh;padding:28rpx 32rpx 64rpx;padding-bottom:calc(64rpx + env(safe-area-inset-bottom))}
.page.dark{--bg:#131b26;--paper:#1b2635;--ink:#edf2f8;--muted:#98a7b9;--blue:#8bc5f5;--blue-strong:#8bc5f5;--soft:#223a50;--line:#2c3a4d}
.page.tab-page{padding-bottom:calc(174rpx + env(safe-area-inset-bottom))}
.eyebrow{display:block;color:var(--blue-strong);font-size:20rpx;letter-spacing:1rpx;font-weight:500}
.title{font-size:43rpx;font-weight:600;letter-spacing:-.5rpx;line-height:1.45;margin:8rpx 0 10rpx}
.subtitle{font-size:25rpx;color:var(--muted);line-height:1.7}.muted{color:var(--muted)}.small{font-size:23rpx}
.section-head{display:flex;justify-content:space-between;align-items:center;gap:14rpx;margin:34rpx 0 18rpx}.section-title{font-size:29rpx;font-weight:500}
.text-button{font-size:24rpx;color:var(--blue-strong);padding:0;background:none;border:0;line-height:1.6}
.card{background:var(--paper);border:1rpx solid var(--line);border-radius:22rpx;overflow:hidden}
.word-row{display:block;text-align:left;width:100%;border-radius:0;border:0;background:var(--paper);padding:26rpx 28rpx}.word-row+.word-row{border-top:1rpx solid var(--line)}
.word{display:block;font-weight:500;font-size:35rpx;overflow-wrap:anywhere;word-break:break-word;line-height:1.4}.meaning{display:block;font-size:26rpx;color:var(--muted);margin-top:8rpx;white-space:pre-line;line-height:1.55}.note-preview{display:block;font-size:24rpx;color:var(--blue-strong);margin-top:10rpx}
.empty{padding:64rpx 28rpx;text-align:center;color:var(--muted);font-size:26rpx;line-height:1.8}
.chips{display:flex;flex-wrap:wrap;margin:0 -6rpx}.page button.chip{width:auto;padding:9rpx 20rpx;font-size:24rpx;border-radius:36rpx;margin:6rpx;color:var(--blue-strong);max-width:100%;white-space:normal;overflow-wrap:anywhere;word-break:break-word}
.primary{color:#fff;background:#2084d3;border-color:#2084d3;font-weight:500}.dark .primary{background:#8bc5f5;border-color:#8bc5f5;color:#132b40}
.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.actions{display:flex;gap:16rpx;margin:24rpx 0}.actions button{flex:1;font-size:26rpx;min-width:0}
.field{background:var(--paper);border:1rpx solid var(--line);border-radius:18rpx;padding:20rpx 24rpx;color:var(--ink);font-size:28rpx;width:100%;min-height:88rpx}
.info{border-radius:18rpx;background:var(--soft);color:var(--muted);padding:22rpx 24rpx;font-size:24rpx;margin:24rpx 0}
.footer{font-size:21rpx;color:var(--muted);line-height:1.8;margin-top:30rpx}
.loading{padding:110rpx 0;text-align:center;color:var(--muted)}.error-card{padding:34rpx}.error-card button{margin-top:24rpx}.error-title{display:block;font-size:33rpx;font-weight:500;margin-bottom:12rpx}
.search-icon{height:30rpx;width:30rpx;flex:none;margin-right:18rpx;opacity:.8}.page-heading{padding:6rpx 0 24rpx}
.pagination{display:flex;justify-content:space-between;align-items:center;padding:24rpx 0;margin-top:18rpx;gap:12rpx}.pagination button{font-size:24rpx;padding:13rpx 24rpx}.pagination text{font-size:23rpx;color:var(--muted)}
.title,.subtitle,.info{overflow-wrap:anywhere;word-break:break-word}
@media(min-width:700px){page{font-size:16px}.page{max-width:900px;margin:0 auto;padding:26px 30px 60px}.page.tab-page{padding-bottom:calc(104px + env(safe-area-inset-bottom))}.title{font-size:28px}.subtitle,.meaning,.small{font-size:14px}.word{font-size:21px}.word-row{padding:17px 22px}.section-title{font-size:18px}.page button.chip,.text-button,.actions button{font-size:14px}.field{font-size:16px;min-height:46px;padding:12px 16px}.eyebrow,.footer{font-size:12px}.row{gap:14px}.headword{font-size:38px!important}.search-input{font-size:17px!important}.source-tabs button{font-size:14px!important}.reader-title{font-size:28px!important}.lookup-sheet{max-width:900px;margin:auto}.metric{font-size:30px!important}}
