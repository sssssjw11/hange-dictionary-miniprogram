.group-mask{position:fixed;inset:0;background:#10253688;z-index:80}.group-sheet{position:fixed;bottom:0;left:0;right:0;z-index:81;padding:30rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:26rpx 26rpx 0 0;background:var(--paper,#fff);color:var(--ink,#193448);box-shadow:0 -8rpx 36rpx #10253622;max-height:88vh}.group-caption{margin:20rpx 0;overflow-wrap:anywhere}.group-options{height:38vh}.group-choice{display:flex;align-items:center;gap:18rpx;padding:22rpx 4rpx;border-bottom:1rpx solid var(--line,#e0eaf1);overflow-wrap:anywhere}.group-choice view{min-width:0}.group-sheet .actions{margin-bottom:0}@media(min-width:700px){.group-sheet{max-width:900px;margin:auto;padding:24px}.group-choice{padding:14px 4px}.group-caption{margin:14px 0}}
