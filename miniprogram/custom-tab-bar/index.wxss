.floating-tabs{position:fixed;z-index:1000;left:22rpx;right:22rpx;bottom:calc(14rpx + env(safe-area-inset-bottom));display:flex;align-items:center;max-width:820px;margin:0 auto;padding:8rpx;border:1rpx solid rgba(221,231,241,.9);border-radius:64rpx;background:rgba(255,255,255,.97);box-shadow:0 8rpx 42rpx rgba(47,79,108,.11);box-sizing:border-box}
.floating-tabs button.tab-item{display:flex;flex:1;flex-direction:column;align-items:center;justify-content:center;gap:4rpx;width:0;min-width:0;height:94rpx;margin:0;padding:8rpx 0;border:0;border-radius:52rpx;background:transparent;box-shadow:none;color:#8b96a3;line-height:1.3;box-sizing:border-box;transition:background-color .16s,color .16s}
.tab-item::after{border:0}.tab-icon{width:46rpx;height:46rpx;flex:none}.tab-label{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:21rpx;white-space:nowrap}.floating-tabs .tab-item.active{background:#edf5fc;color:#2189dc;font-weight:500}.tab-hover{opacity:.72}
.floating-tabs.dark{background:rgba(26,35,48,.97);border-color:#2c394b;box-shadow:0 8rpx 42rpx rgba(0,0,0,.2)}.floating-tabs.dark .tab-item{color:#9ba8b8}.floating-tabs.dark .tab-item.active{background:#233a50;color:#8bc5f5}
@media(min-width:700px){.floating-tabs{left:24px;right:24px;bottom:calc(10px + env(safe-area-inset-bottom));padding:6px;border-radius:38px}.floating-tabs button.tab-item{height:58px;gap:3px;border-radius:32px}.tab-icon{width:26px;height:26px}.tab-label{font-size:13px}}
