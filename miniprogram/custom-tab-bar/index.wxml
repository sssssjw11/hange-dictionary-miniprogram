<view wx:if="{{!keyboard}}" class="floating-tabs {{theme}}">
  <button wx:for="{{items}}" wx:key="pagePath" class="tab-item {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onSwitch" hover-class="tab-hover" aria-label="{{item.text}}">
    <image class="tab-icon" src="{{selected === index ? item.selectedIcon : item.icon}}"/>
    <text class="tab-label">{{item.text}}</text>
  </button>
</view>
